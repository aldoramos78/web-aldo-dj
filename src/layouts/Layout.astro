---
import SEO from '../components/seo/SEO.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  includeMusicRecording?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  noindex,
  includeMusicRecording = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <SEO 
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <SchemaOrg includeMusicRecording={includeMusicRecording} />
  </head>
  <body class="bg-[#0D0D11] text-white font-sans antialiased selection:bg-purple-600 selection:text-white">
    
    <!-- Canvas de Partículas Optimizado para Rendimiento & Batería -->
    <canvas id="particles-bg"></canvas>

    <Header />

    <slot />

    <Footer />

    <!-- Botón Subir Elegante: Compacto en móvil, interior transparente y marco tornasol con blur -->
    <button
      id="back-to-top"
      aria-label="Volver arriba"
      class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40 w-10 h-10 sm:w-12 sm:h-12 rounded-full opacity-0 pointer-events-none translate-y-3 transition-all duration-300 ease-out group focus:outline-none"
    >
      <!-- Halo exterior morado blur en el marco -->
      <div class="tornasol-glow absolute -inset-1 rounded-full blur-md opacity-60 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

      <!-- Estructura circular con interior transparente y marco tornasol -->
      <div class="relative w-full h-full rounded-full transition-transform duration-300 group-hover:scale-105 active:scale-95 flex items-center justify-center">
        <!-- Anillo SVG con gradiente tornasol idéntico al H2 y centro 100% transparente -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 48 48" fill="none">
          <defs>
            <linearGradient id="btn-tornasol-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FFFFFF" />
              <stop offset="20%" stop-color="#F3E8FF" />
              <stop offset="45%" stop-color="#C084FC" />
              <stop offset="70%" stop-color="#E879F9" />
              <stop offset="85%" stop-color="#A855F7" />
              <stop offset="100%" stop-color="#FFFFFF" />
            </linearGradient>
          </defs>
          <circle cx="24" cy="24" r="22" stroke="url(#btn-tornasol-grad)" stroke-width="2.2" fill="transparent" />
        </svg>

        <!-- Flecha Blanca Nítida sin obstrucción -->
        <svg 
          class="relative z-10 w-4 h-4 sm:w-5 sm:h-5 text-white transition-transform duration-300 group-hover:-translate-y-0.5 filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.95)]" 
          fill="none" 
          stroke="currentColor" 
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </div>
    </button>

    <style is:global>
      /* Halo exterior con resplandor morado difuminado en el marco */
      .tornasol-glow {
        background: radial-gradient(circle, rgba(168, 85, 247, 0.65) 0%, rgba(192, 132, 252, 0.35) 50%, transparent 75%);
      }
    </style>

    <!-- Script de Scroll para Botón Subir -->
    <script>
      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 350) {
            backToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
            backToTopBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
          } else {
            backToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
            backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
          }
        }, { passive: true });

        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });
      }
    </script>

    <!-- Script de Partículas Condicional y Ligero -->
    <script>
      const canvas = document.getElementById('particles-bg') as HTMLCanvasElement | null;
      if (canvas) {
        const isMobile = window.innerWidth < 768;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Si el usuario prefiere movimiento reducido o es móvil de bajo rendimiento, omitimos la física continua
        if (!prefersReducedMotion) {
          const ctx = canvas.getContext('2d');
          if (ctx) {
            let width = (canvas.width = window.innerWidth);
            let height = (canvas.height = window.innerHeight);
            let lastWidth = window.innerWidth;

            window.addEventListener('resize', () => {
              // Solo redimensionar si cambia el ancho (ej: rotación de pantalla).
              // Evita que la aparición/desaparición de la barra de navegación móvil en scroll recalcule el canvas.
              if (window.innerWidth !== lastWidth) {
                lastWidth = window.innerWidth;
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
              }
            }, { passive: true });

            // En móvil solo 15 partículas lentas; en escritorio hasta 45
            const count = isMobile ? 15 : 40;
            const particles: Array<{ x: number; y: number; vx: number; vy: number; size: number }> = [];

            for (let i = 0; i < count; i++) {
              particles.push({
                x: Math.random() * width,
                y: Math.random() * height,
                vx: (Math.random() - 0.5) * (isMobile ? 0.2 : 0.4),
                vy: (Math.random() - 0.5) * (isMobile ? 0.2 : 0.4),
                size: Math.random() * 1.5 + 0.5
              });
            }

            let animationId: number;
            function render() {
              if (!ctx) return;
              ctx.clearRect(0, 0, width, height);
              ctx.fillStyle = 'rgba(139, 92, 246, 0.4)';

              for (let i = 0; i < particles.length; i++) {
                const p = particles[i];
                p.x += p.vx;
                p.y += p.vy;

                if (p.x < 0) p.x = width;
                if (p.x > width) p.x = 0;
                if (p.y < 0) p.y = height;
                if (p.y > height) p.y = 0;

                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
              }

              animationId = requestAnimationFrame(render);
            }

            render();

            // Pausar si la pestaña no está visible para ahorrar 100% de CPU
            document.addEventListener('visibilitychange', () => {
              if (document.hidden) {
                cancelAnimationFrame(animationId);
              } else {
                render();
              }
            });
          }
        }
      }
    </script>
  </body>
</html>
