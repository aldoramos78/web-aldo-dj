    venueTag: "Peak Time Club",
    dotColor: "bg-fuchsia-500 shadow-[0_0_8px_rgba(217,70,239,0.8)]",
    image: "/imagenes/Portada.Clubbing.webp",
    badges: ["CLUB BANGERS", "LATIN TECH", "125-130 BPM"],
    description: "Energía pura para salas nocturnas, macro-eventos y festivales. Mezcla dinámica de tech house contundente, remixes exclusivos y bangers latinos que mantienen la pista en constante ebullición.",
    trackTitle: "Peak Hour Club Experience 2025",
    trackMeta: "78:15 • Festival Edition",
    actionText: "Escuchar Set",
    actionLink: "https://soundcloud.com/aldo-ramos-espin",
    soundCloudUrl: "https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/aldo-ramos-espin&color=%238b5cf6&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false"
  },
  {
    id: "featurings",
    title: "Featurings",
    category: "03 / LIVE SHOWS & INSTRUMENTALS",
    venueTag: "Show Híbrido",
    dotColor: "bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]",
    image: "/imagenes/Portada.Feat.webp",
    badges: ["LIVE FUSION", "VIOLIN & SAX", "VOCALS"],
