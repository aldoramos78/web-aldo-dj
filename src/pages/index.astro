---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hero/Hero.astro';
import About from '../components/about/About.astro';
import CreepTeaser from '../components/music/CreepTeaser.astro';
import SetsGallery from '../components/sets/SetsGallery.astro';
import ShowcaseCoverflow from '../components/showcase/ShowcaseCoverflow.astro';
import FAQ from '../components/faq/FAQ.astro';
import Contact from '../components/contact/Contact.astro';
---

<Layout
  title="ALDO DEEJAY | DJ para Hoteles, Bodas y Eventos en Fuerteventura y Canarias"
  description="Sesiones DJ con identidad, estética cuidada y sonido profesional para hoteles, terrazas, bodas y eventos en Fuerteventura y Canarias. Respaldado por VIP CRAB EVENTS, S.L.U."
  ogImage="https://www.aldodeejay.com/imagenes/silueta.webp"
>
  <main>
    <Hero />
    <About />
    <CreepTeaser />
    <SetsGallery />
    <ShowcaseCoverflow />
    <FAQ />
    <Contact />
  </main>
</Layout>
