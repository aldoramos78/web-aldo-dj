  {
    id: "poolside",
    title: "Poolside Vibes",
    category: "01 / SUNSET & RELAXED BEATS",
    venueTag: "Hotel & Rooftop",
    dotColor: "bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]",
    image: "/imagenes/Portada.Poolside.webp",
    badges: ["AFRO DEEP", "BALEARIC", "116-122 BPM"],
    description: "Atmósferas cálidas y elegantes pensadas para terrazas al atardecer, beach clubs y hoteles boutique de lujo. Texturas orgánicas, percusiones sutiles y melodías que fluyen con la caída del sol.",
    trackTitle: "Sunset Terrace Session (Live Mix)",
    trackMeta: "64:20 • 320 kbps High-Res",
    actionText: "Escuchar Set",
    actionLink: "https://soundcloud.com/aldo-ramos-espin",
    soundCloudUrl: "https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/aldo-ramos-espin&color=%238b5cf6&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false"
  },
  {
