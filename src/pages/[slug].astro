---
import Layout from '../layouts/Layout.astro';
import { SHOWCASE_FORMATS, type ShowcaseFormat } from '../data/formats';

export function getStaticPaths() {
  return SHOWCASE_FORMATS.map((item) => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

interface Props {
  item: ShowcaseFormat;
}

const { item } = Astro.props;
const absoluteImage = `https://www.aldodeejay.com${item.image}`;
---

<Layout
  title={`${item.title} · Aldo Deejay | Espectáculos y Sesiones DJ`}
  description={item.shortDesc}
  canonical={`https://www.aldodeejay.com/${item.slug}/`}
  ogImage={absoluteImage}
>
  <!-- Fondo inmersivo con el cartel desenfocado (misma estética que /creep) -->
  <div class="format-backdrop" style={`--poster-bg: url("${item.image}")`} aria-hidden="true"></div>

  <main class="min-h-screen pt-28 pb-20 relative overflow-hidden">
    <!-- Glow morado 3D -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-purple-600/20 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <div class="max-w-xl mx-auto px-4 sm:px-6 relative z-10 flex flex-col items-center">
      <!-- Botón Volver arriba con flecha -->
      <a href="/#showcase" class="inline-flex items-center gap-2 text-xs uppercase tracking-wider text-gray-400 hover:text-white transition-colors mb-6 self-start group">
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Volver al Showcase
      </a>

      <!-- Tarjeta vertical 3D morada coherente con /creep -->
      <div class="glass-panel rounded-3xl p-6 sm:p-10 border border-purple-500/30 shadow-[0_0_60px_rgba(139,92,246,0.35)] text-center relative overflow-hidden w-full flex flex-col items-center">
        
        <!-- Cartel vertical del espectáculo -->
        <div class="w-full max-w-[360px] aspect-[4/5] rounded-2xl overflow-hidden border border-purple-500/35 shadow-[0_25px_60px_rgba(0,0,0,0.65),0_0_45px_rgba(139,92,246,0.25)] bg-black">
          <img
            src={item.image}
            alt={`Cartel oficial ${item.title} - Aldo Deejay`}
            class="w-full h-full object-cover"
            width="720"
            height="900"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- Eyebrow & Título -->
        <p class="mt-7 text-xs tracking-[0.28em] uppercase text-purple-300 font-semibold">
          {item.eyebrow}
        </p>
        <h1 class="mt-2.5 text-4xl sm:text-5xl font-black text-white uppercase tracking-tight leading-none">
          {item.title}
        </h1>

        <!-- Badges Ideal Para -->
        <div class="mt-5 flex flex-wrap justify-center gap-2">
          {item.idealFor.map((tag) => (
            <span class="px-3 py-1 rounded-full bg-purple-900/45 border border-purple-500/30 text-xs font-semibold text-purple-200">
              {tag}
            </span>
          ))}
        </div>

        <!-- Descripción detallada -->
        <p class="mt-6 text-base sm:text-lg text-white/95 font-normal leading-relaxed">
          {item.longDesc}
        </p>

        <!-- Reproductor SoundCloud si está disponible -->
        {item.soundCloudEmbed && (
          <div class="w-full mt-7 pt-5 border-t border-purple-500/20">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-purple-300 block mb-3">
              Escucha el adelanto en SoundCloud
            </span>
            <div class="rounded-2xl overflow-hidden border border-purple-500/40 bg-[#0B0B10] shadow-xl">
              <iframe
                width="100%"
                height="166"
                scrolling="no"
                frameborder="no"
                allow="autoplay"
                src={item.soundCloudEmbed}
                loading="lazy"
              ></iframe>
            </div>
            {item.listenLink && (
              <a
                href={item.listenLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block mt-2.5 text-xs text-purple-300 hover:text-white underline transition-colors"
              >
                Abrir pista en SoundCloud &rarr;
              </a>
            )}
          </div>
        )}

        <!-- CTA Principal -->
        <div class="mt-8 w-full flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/#contact" class="btn-primary w-full sm:w-auto text-xs sm:text-sm !py-3.5 !px-10">
            RESERVAR ESTE FORMATO
          </a>
        </div>

        <p class="mt-6 text-xs text-gray-400">
          Producción y contratación directa en Fuerteventura y Canarias &bull; VIP CRAB EVENTS, S.L.U.
        </p>

      </div>
    </div>
  </main>
</Layout>

<style>
  .format-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .format-backdrop::before {
    content: "";
    position: absolute;
    inset: -60px;
    background-image: var(--poster-bg);
    background-position: center;
    background-size: cover;
    filter: blur(48px) saturate(1.1) brightness(0.35);
    transform: scale(1.1) translateZ(0);
    will-change: transform;
  }
  .format-backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 30%, rgba(13, 13, 17, 0) 0%, rgba(13, 13, 17, 0.65) 55%, #0d0d11 100%),
      linear-gradient(180deg, rgba(109, 40, 217, 0.18), rgba(13, 13, 17, 0) 40%);
  }
</style>
