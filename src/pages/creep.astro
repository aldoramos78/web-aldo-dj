---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Creep (Afro House) · Aldo Deejay feat. Yami Gonzalez"
  description="Creep (Afro House), versión de Aldo Deejay feat. Yami Gonzalez. DJ y productor en Fuerteventura, Islas Canarias. Disponible el 4 de diciembre de 2026 en Spotify, Apple Music, YouTube Music y todas las plataformas."
  canonical="https://www.aldodeejay.com/creep/"
  ogImage="https://www.aldodeejay.com/img/creep-og.jpg"
  ogType="music.song"
  includeMusicRecording={true}
>
  <div class="backdrop" aria-hidden="true"></div>

  <main class="min-h-screen pt-28 pb-20 relative overflow-hidden">
    <!-- Ambient 3D Purple Glow -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-purple-600/20 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <div class="max-w-xl mx-auto px-4 sm:px-6 relative z-10 flex flex-col items-center">
      <!-- Botón Volver arriba con flecha -->
      <a href="/" class="inline-flex items-center gap-2 text-xs uppercase tracking-wider text-gray-400 hover:text-white transition-colors mb-6 self-start group">
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Volver a aldodeejay.com
      </a>

      <!-- Caja con borde y sombra moradita 3D -->
      <div class="glass-panel rounded-3xl p-6 sm:p-10 border border-purple-500/30 shadow-[0_0_60px_rgba(139,92,246,0.35)] text-center relative overflow-hidden w-full flex flex-col items-center">
        
        <div class="cover">
          <img 
            src="/img/creep-cover.webp" 
            alt="Portada de Creep (Afro House), Aldo Deejay feat. Yami Gonzalez" 
            width="1200" 
            height="1200"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <p class="eyebrow" id="eyebrow">Nuevo single</p>
        <h1 class="release-title">Creep<span>AFRO HOUSE</span></h1>
        <p class="artists">Aldo Deejay <em>feat.</em> Yami Gonzalez</p>

        <!-- Reproductor del adelanto -->
        <div class="player" id="player">
          <button class="play" id="playBtn" aria-label="Reproducir adelanto">
            <svg viewBox="0 0 24 24" id="playIcon"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <div class="ptrack">
            <div class="ptitle"><span><b>Adelanto</b> · Creep (Afro House)</span><span id="ptime">0:00 / 0:30</span></div>
            <div class="bar" id="bar" role="slider" aria-label="Posición del adelanto" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0"><div class="fill" id="fill"></div></div>
          </div>
          <audio id="teaser" src="/audio/creep-teaser.mp3" preload="metadata"></audio>
        </div>

        <!-- Cuenta atrás -->
        <section class="count" id="countdown" aria-live="polite">
          <p class="count-label">Disponible el <strong>4 de diciembre de 2026</strong></p>
          <div class="clock">
            <div class="unit"><span class="num" id="d">--</span><span class="lbl">días</span></div>
            <div class="unit"><span class="num" id="h">--</span><span class="lbl">horas</span></div>
            <div class="unit"><span class="num" id="m">--</span><span class="lbl">min</span></div>
            <div class="unit"><span class="num" id="s">--</span><span class="lbl">seg</span></div>
          </div>
        </section>

        <!-- Botones de plataformas -->
        <nav class="platforms" id="platforms" aria-label="Escuchar en"></nav>

        <p class="follow">
          Sigue a <a href="https://www.instagram.com/aldo.deejay/" target="_blank" rel="noopener noreferrer">@aldo.deejay</a> y a <a href="https://www.instagram.com/yamila_music/" target="_blank" rel="noopener noreferrer">@yamila_music</a> en Instagram para no perdértelo
        </p>

        <!-- Bloque de créditos oficiales -->
        <p class="credits">
          <strong>Creep (Afro House)</strong> · versión de la canción original de Radiohead.<br>
          Compositores: Thom Yorke, Jonny Greenwood, Colin Greenwood, Ed O'Brien, Philip Selway, Albert Hammond, Mike Hazlewood.<br>
          Producción y arreglos: Aldo Deejay · Voz: Yami Gonzalez · &copysr; 2026 Aldo Deejay
        </p>

      </div>
    </div>
  </main>
</Layout>

<style>
  :root {
    --accent: #c084fc;
    --accent-soft: #d8b4fe;
    --violet: #8b5cf6;
    --violet-deep: #6d28d9;
    --play: #9333ea;
    --line: rgba(168, 85, 247, 0.28);
    --card: rgba(26, 26, 34, 0.75);
    --muted: #9ca3af;
    --ink: #ffffff;
  }

  /* Fondo: la portada desenfocada */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .backdrop::before {
    content: "";
    position: absolute;
    inset: -60px;
    background: url(/img/creep-cover.jpg) center/cover no-repeat;
    filter: blur(48px) saturate(1.1) brightness(0.42);
    transform: scale(1.1) translateZ(0);
    will-change: transform;
  }
  .backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 30%, rgba(13, 13, 17, 0) 0%, rgba(13, 13, 17, 0.6) 55%, #0d0d11 100%),
      linear-gradient(180deg, rgba(109, 40, 217, 0.18), rgba(13, 13, 17, 0) 40%);
  }

  .cover {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6), 0 0 60px rgba(139, 92, 246, 0.25), 0 0 0 1px var(--line);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .eyebrow {
    margin-top: 28px;
    font-size: 0.78rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }
  .release-title {
    margin-top: 10px;
    font-weight: 800;
    font-size: clamp(2.2rem, 8vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: #ffffff;
  }
  .release-title span {
    display: block;
    font-weight: 300;
    font-size: 0.42em;
    letter-spacing: 0.38em;
    margin-top: 10px;
    color: var(--accent);
  }
  .artists {
    margin-top: 14px;
    font-size: 1.08rem;
    color: #ffffff;
  }
  .artists em {
    font-style: normal;
    color: var(--muted);
    font-size: 0.9em;
    margin: 0 0.25em;
  }

  /* Cuenta atrás */
  .count {
    margin-top: 28px;
    width: 100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 12px;
    backdrop-filter: blur(8px);
  }
  .count-label {
    font-size: 0.82rem;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .count-label strong {
    color: #ffffff;
    font-weight: 600;
  }
  .clock {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 12px;
  }
  .unit {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .num {
    font-size: clamp(1.6rem, 7vw, 2.2rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .lbl {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 2px;
  }

  /* Botones de plataformas */
  .platforms {
    margin-top: 22px;
    width: 100%;
    display: grid;
    gap: 10px;
  }
  :global(.btn) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 15px 18px;
    border-radius: 12px;
    border: 1px solid rgba(168, 85, 247, 0.28);
    background: rgba(26, 26, 34, 0.75);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    color: #ffffff;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    backdrop-filter: blur(8px);
    box-sizing: border-box;
  }
  :global(.btn .act) {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #c084fc;
  }
  :global(.btn:hover) {
    transform: translateY(-2px);
    border-color: #c084fc;
    background: rgba(168, 85, 247, 0.12);
  }
  :global(.btn.off) {
    cursor: default;
    opacity: 0.55;
  }
  :global(.btn.off:hover) {
    transform: none;
    border-color: rgba(168, 85, 247, 0.28);
    background: rgba(26, 26, 34, 0.75);
  }
  :global(.btn.off .act) {
    color: #9ca3af;
  }
  :global(.btn.main) {
    background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    color: #ffffff;
    border: none;
  }
  :global(.btn.main .act) {
    color: #ffffff;
  }
  :global(.btn.main:hover) {
    background: linear-gradient(135deg, #9d74f8, #7c3aed);
  }

  /* Reproductor del adelanto */
  .player {
    margin-top: 22px;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    backdrop-filter: blur(8px);
  }
  .play {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: var(--play);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 0 24px rgba(147, 51, 234, 0.45);
    transition: transform 0.15s ease;
  }
  .play:hover {
    transform: scale(1.06);
  }
  .play svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .ptrack {
    flex: 1;
    min-width: 0;
    text-align: left;
  }
  .ptitle {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .ptitle b {
    color: #ffffff;
    font-weight: 600;
  }
  .bar {
    margin-top: 9px;
    height: 6px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.1);
    cursor: pointer;
    position: relative;
  }
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--violet), var(--accent));
  }
  .follow {
    margin-top: 26px;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .follow a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .credits {
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 460px;
  }
  .credits strong {
    color: #ffffff;
    font-weight: 600;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.btn) {
      transition: none;
    }
  }
</style>

<script>
  /* ============================================================
     EL DÍA DEL LANZAMIENTO (4/12/2026) SOLO HAY QUE RELLENAR
     LOS ENLACES DE CADA PLATAFORMA AQUÍ ABAJO.
     Los botones sin enlace se muestran como "Próximamente".
     ============================================================ */
  const RELEASE = new Date('2026-12-04T00:00:00Z'); // medianoche en Canarias
  const LINKS = [
    { name: 'Spotify',       url: '' , main: true },
    { name: 'Apple Music',   url: '' },
    { name: 'YouTube Music', url: '' },
    { name: 'Amazon Music',  url: '' },
    { name: 'Deezer',        url: '' },
    { name: 'Tidal',         url: '' }
  ];

  const nav = document.getElementById('platforms');
  function renderButtons(released: boolean) {
    if (!nav) return;
    nav.innerHTML = '';
    LINKS.forEach(p => {
      const ready = released && Boolean(p.url);
      const el = document.createElement(ready ? 'a' : 'div');
      el.className = 'btn' + (ready && p.main ? ' main' : '') + (ready ? '' : ' off');
      if (ready) { 
        (el as HTMLAnchorElement).href = p.url; 
        (el as HTMLAnchorElement).target = '_blank'; 
        (el as HTMLAnchorElement).rel = 'noopener noreferrer'; 
      } else { 
        el.setAttribute('aria-disabled', 'true'); 
      }
      el.innerHTML = '<span>' + p.name + '</span><span class="act">' + (ready ? 'Escuchar' : 'Próximamente') + '</span>';
      nav.appendChild(el);
    });
  }

  const pad = (n: number) => String(n).padStart(2, '0');
  function tick() {
    const diff = RELEASE.getTime() - Date.now();
    const countEl = document.getElementById('countdown');
    const eyebrowEl = document.getElementById('eyebrow');
    if (diff <= 0) {
      if (countEl) countEl.hidden = true;
      if (eyebrowEl) eyebrowEl.textContent = 'Ya disponible';
      renderButtons(true);
      return false;
    }
    const s = Math.floor(diff / 1000);
    const dEl = document.getElementById('d');
    const hEl = document.getElementById('h');
    const mEl = document.getElementById('m');
    const sEl = document.getElementById('s');
    if (dEl) dEl.textContent = String(Math.floor(s / 86400));
    if (hEl) hEl.textContent = pad(Math.floor((s % 86400) / 3600));
    if (mEl) mEl.textContent = pad(Math.floor((s % 3600) / 60));
    if (sEl) sEl.textContent = pad(s % 60);
    return true;
  }

  /* Reproductor del adelanto */
  const au = document.getElementById('teaser') as HTMLAudioElement | null;
  const btn = document.getElementById('playBtn');
  const icon = document.getElementById('playIcon');
  const bar = document.getElementById('bar');
  const fill = document.getElementById('fill');
  const tm = document.getElementById('ptime');
  const fmt = (t: number) => Math.floor(t / 60) + ':' + String(Math.floor(t % 60)).padStart(2, '0');
  const PLAY = '<path d="M8 5v14l11-7z"/>';
  const PAUSE = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>';

  if (btn && au && icon) {
    btn.onclick = () => { au.paused ? au.play() : au.pause(); };
    au.onplay = () => { icon.innerHTML = PAUSE; btn.setAttribute('aria-label', 'Pausar adelanto'); };
    au.onpause = au.onended = () => { icon.innerHTML = PLAY; btn.setAttribute('aria-label', 'Reproducir adelanto'); };
  }

  if (au && fill && bar && tm) {
    au.ontimeupdate = au.onloadedmetadata = () => {
      const d = au.duration || 30;
      const pc = (au.currentTime / d) * 100;
      fill.style.width = pc + '%';
      bar.setAttribute('aria-valuenow', String(Math.round(pc)));
      tm.textContent = fmt(au.currentTime) + ' / ' + fmt(d);
    };
    bar.onclick = (e: MouseEvent) => {
      const r = bar.getBoundingClientRect();
      if (au.duration) au.currentTime = ((e.clientX - r.left) / r.width) * au.duration;
    };
    bar.onkeydown = (e: KeyboardEvent) => {
      if (!au.duration) return;
      if (e.key === 'ArrowRight') au.currentTime = Math.min(au.duration, au.currentTime + 5);
      if (e.key === 'ArrowLeft') au.currentTime = Math.max(0, au.currentTime - 5);
    };
  }

  renderButtons(false);
  if (tick()) {
    const t = setInterval(() => {
      if (!tick()) clearInterval(t);
    }, 1000);
  }
</script>
