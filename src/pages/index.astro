---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hero/Hero.astro';
import TeaserPlayer from '../components/TeaserPlayer.astro';
import About from '../components/about/About.astro';
import SetsGallery from '../components/sets/SetsGallery.astro';
import ShowcaseCoverflow from '../components/showcase/ShowcaseCoverflow.astro';
import CreepTeaser from '../components/music/CreepTeaser.astro';
import FAQ from '../components/faq/FAQ.astro';
import Contact from '../components/contact/Contact.astro';
---

<Layout
  title="ALDO DEEJAY | DJ para Hoteles, Bodas y Eventos en Fuerteventura y Canarias"
  description="DJ y productor musical en Fuerteventura y Canarias. Sesiones con identidad y sonido profesional para hoteles, terrazas, beach clubs, bodas y eventos."
  ogImage="https://www.aldodeejay.com/imagenes/og-card.jpg"
>
  <main>
    <Hero headerHeight="5rem">
      <TeaserPlayer src="/audio/creep-teaser.mp3" />
    </Hero>
    <About />
    <SetsGallery />
    <ShowcaseCoverflow />
    <CreepTeaser />
    <FAQ />
    <Contact />
  </main>
</Layout>
