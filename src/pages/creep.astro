---
import Layout from '../layouts/Layout.astro';

const releaseData = {
  title: "Creep (Afro House Cover)",
  artist: "Aldo feat. Yami González",
  genre: "Afro House / Melodic Dance",
  bpm: "122 BPM",
  key: "G Minor",
  status: "Lanzamiento Inminente · Pre-Save Activo"
};
---

<Layout 
  title="CREEP (Afro House Cover) - ALDO feat. Yami González | Pre-Save Oficial"
  description="Pre-Save oficial de 'Creep (Afro House Cover)' producido por Aldo e interpretado por Yami González. Escucha el adelanto exclusivo."
  ogImage="https://www.aldodeejay.com/imagenes/Portada_Creep.webp"
  includeMusicRecording={true}
>
  <main class="min-h-screen pt-28 pb-20 relative overflow-hidden">
    
    <!-- Background Glows -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-purple-600/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back Link -->
      <a href="/" class="inline-flex items-center gap-2 text-xs uppercase tracking-wider text-gray-400 hover:text-white transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Volver a aldodeejay.com
      </a>

      <!-- Release Header Card -->
      <div class="glass-panel rounded-3xl p-6 sm:p-10 border border-purple-500/30 shadow-[0_0_50px_rgba(139,92,246,0.3)] text-center relative overflow-hidden">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-900/60 border border-purple-500/30 text-purple-300 text-xs uppercase tracking-widest font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
          {releaseData.status}
        </div>

        <!-- Single Artwork Limpia con texto debajo -->
        <div class="flex flex-col items-center mb-6">
          <div class="mx-auto w-64 sm:w-80 aspect-square rounded-2xl overflow-hidden shadow-2xl border border-purple-500/40 bg-black">
            <img 
              src="/imagenes/Portada_Creep.webp" 
              alt="Creep Cover Artwork - Aldo feat. Yami González" 
              class="w-full h-full object-cover"
              width="750"
              height="750"
              fetchpriority="high"
            />
          </div>
          <p class="mt-3 text-xs uppercase tracking-widest text-purple-300 font-semibold">
            Primer single oficial
          </p>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white uppercase tracking-tight">
          CREEP <span class="text-purple-400">(Afro House Cover)</span>
        </h1>
        <p class="text-xs uppercase tracking-widest text-gray-400 font-medium mt-1">
          Aldo feat. Yami González
        </p>
        
        <p class="text-sm sm:text-base text-gray-300 font-light mt-4 max-w-xl mx-auto leading-relaxed">
          Cover en clave Afro House del clásico "Creep". Interpretado por Yami González, artista Cubana con una voz cálida y elegante. Groove percusivo envolvente, atmósferas melódicas y la potencia adecuada para sets de club y atardeceres frente al mar.
        </p>

        <!-- Technical Metadata Badges -->
        <div class="flex flex-wrap items-center justify-center gap-3 my-6">
          <span class="px-3 py-1 rounded-md bg-white/5 border border-white/10 text-xs text-gray-300">
            <strong>BPM:</strong> {releaseData.bpm}
          </span>
          <span class="px-3 py-1 rounded-md bg-white/5 border border-white/10 text-xs text-gray-300">
            <strong>Tonalidad:</strong> {releaseData.key}
          </span>
          <span class="px-3 py-1 rounded-md bg-white/5 border border-white/10 text-xs text-gray-300">
            <strong>Género:</strong> {releaseData.genre}
          </span>
        </div>

        <!-- Audio Preview Player Section -->
        <div class="max-w-md mx-auto my-8 p-4 rounded-xl bg-black/60 border border-purple-500/20 backdrop-blur-md">
          <div class="flex items-center justify-between text-xs text-gray-400 mb-2">
            <span>Audio Preview (Sample)</span>
            <span id="player-time">0:00 / 0:30</span>
          </div>
          
          <div class="flex items-center gap-4">
            <button 
              id="play-pause-btn" 
              class="w-12 h-12 rounded-full bg-purple-600 text-white flex items-center justify-center hover:bg-purple-500 transition-colors shadow-lg"
              aria-label="Reproducir adelanto"
            >
              <svg id="play-icon" class="w-6 h-6 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg id="pause-icon" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <div class="flex-1 bg-white/10 h-2 rounded-full overflow-hidden relative cursor-pointer" id="progress-bar-container">
              <div id="progress-bar" class="bg-gradient-to-r from-purple-500 to-indigo-400 h-full w-0 transition-all duration-150"></div>
            </div>
          </div>
          
          <audio id="audio-preview" preload="none">
            <source src="" type="audio/mpeg">
          </audio>
        </div>

        <!-- Pre-Save Streaming Buttons -->
        <div class="space-y-3 max-w-md mx-auto mt-8">
          <h3 class="text-xs uppercase tracking-widest text-gray-400 font-semibold mb-4">
            Pre-Guarda en tu plataforma preferida
          </h3>

          <a 
            href="https://open.spotify.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center justify-between px-5 py-3.5 rounded-xl bg-[#1DB954]/15 hover:bg-[#1DB954]/25 border border-[#1DB954]/40 text-white transition-all group"
          >
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6 text-[#1DB954]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
              <span class="text-sm font-semibold tracking-wide">Spotify Pre-Save</span>
            </div>
            <span class="text-xs uppercase text-purple-300 font-semibold group-hover:translate-x-1 transition-transform">Pre-Guardar &rarr;</span>
          </a>

          <a 
            href="https://music.apple.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center justify-between px-5 py-3.5 rounded-xl bg-[#FA243C]/15 hover:bg-[#FA243C]/25 border border-[#FA243C]/40 text-white transition-all group"
          >
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6 text-[#FA243C]" fill="currentColor" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.56.64-1.06 1.7-0.93 2.73 1.01.08 2.04-.48 2.66-1.23z"/></svg>
              <span class="text-sm font-semibold tracking-wide">Apple Music Pre-Add</span>
            </div>
            <span class="text-xs uppercase text-purple-300 font-semibold group-hover:translate-x-1 transition-transform">Pre-Añadir &rarr;</span>
          </a>

          <a 
            href="https://www.beatport.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center justify-between px-5 py-3.5 rounded-xl bg-purple-900/30 hover:bg-purple-900/50 border border-purple-500/40 text-white transition-all group"
          >
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-purple-600 font-black text-xs flex items-center justify-center text-white">BP</span>
              <span class="text-sm font-semibold tracking-wide">Beatport Wishlist</span>
            </div>
            <span class="text-xs uppercase text-purple-300 font-semibold group-hover:translate-x-1 transition-transform">Guardar &rarr;</span>
          </a>
        </div>

      </div>
    </div>
  </main>
</Layout>

<script>
  // Simple Mock/Preview Player logic
  const playBtn = document.getElementById('play-pause-btn');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  const progressBar = document.getElementById('progress-bar');
  const timeDisplay = document.getElementById('player-time');
  let isPlaying = false;
  let progress = 0;
  let timer: any = null;

  playBtn?.addEventListener('click', () => {
    isPlaying = !isPlaying;
    if (isPlaying) {
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');
      timer = setInterval(() => {
        progress += 1;
        if (progress > 30) {
          progress = 0;
          isPlaying = false;
          playIcon?.classList.remove('hidden');
          pauseIcon?.classList.add('hidden');
          clearInterval(timer);
        }
        if (progressBar) progressBar.style.width = `${(progress / 30) * 100}%`;
        if (timeDisplay) timeDisplay.textContent = `0:${progress < 10 ? '0' + progress : progress} / 0:30`;
      }, 1000);
    } else {
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');
      clearInterval(timer);
    }
  });
</script>
