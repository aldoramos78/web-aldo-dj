---
import { SHOWCASE_FORMATS } from '../../data/formats';
---

<section id="showcase" class="scroll-mt-0 pt-20 sm:pt-24 lg:pt-28 pb-6 sm:pb-8 lg:pb-10 relative overflow-hidden">
  <!-- Contenedor Cinematográfico Extendido -->
  <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-10 xl:px-14">
    
    <!-- Encabezado compacto para encajar en una pantalla móvil sin desbordar -->
    <div class="text-center mb-5 sm:mb-10 lg:mb-12">
      <span class="text-[11px] sm:text-sm font-bold tracking-[0.28em] text-[#A78BFA] uppercase block mb-2">
        Espectáculos Especiales
      </span>
      <h2 class="section-title !mb-3">
        SHOWCASE
      </h2>
      <div class="mx-auto w-32 sm:w-36 h-[2.5px] rounded-full bg-gradient-to-r from-transparent via-[#8B5CF6] to-transparent shadow-[0_0_16px_rgba(139,92,246,0.9)] mb-3"></div>
      <p class="text-white/90 max-w-2xl mx-auto text-sm sm:text-lg font-normal leading-relaxed">
        Toca cualquier cartel lateral para traerlo al frente o pulsa en el activo para ver su ficha.
      </p>
    </div>

    <!-- Coverflow Component Container -->
    <div class="relative w-full flex flex-col items-center">
      
      <!-- 3D Viewport ajustado para caber completo en 1 pantalla móvil -->
      <div class="coverflow-wrapper relative w-full h-[340px] sm:h-[440px] lg:h-[500px] flex items-center justify-center [perspective:1200px] select-none touch-pan-y">
        
        <!-- Flecha Anterior (Solo Escritorio) -->
        <button 
          id="coverflow-prev" 
          class="hidden lg:flex absolute left-6 xl:left-12 z-[60] w-12 h-12 rounded-full bg-black/70 border border-purple-500/40 text-white items-center justify-center hover:bg-purple-600 hover:border-purple-400 transition-all shadow-[0_0_20px_rgba(139,92,246,0.4)] backdrop-blur-md"
          aria-label="Anterior Formato"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>

        <!-- Dynamic Items Container -->
        <div id="coverflow-stage" class="relative w-full h-full flex items-center justify-center [transform-style:preserve-3d]">
          {SHOWCASE_FORMATS.map((item, index) => (
            <div 
              class={`coverflow-item absolute cursor-pointer rounded-2xl overflow-hidden shadow-2xl transition-all duration-500 ease-out will-change-transform ${index === 0 ? 'active' : ''}`}
              data-index={index}
              data-slug={item.slug}
              data-title={item.title}
              data-eyebrow={item.eyebrow}
              data-desc={item.shortDesc}
              data-image={item.image}
              data-ideal={JSON.stringify(item.idealFor)}
              data-listen={item.listenLink || ''}
              data-embed={item.soundCloudEmbed || ''}
            >
              <img 
                src={item.image} 
                alt={item.title} 
                class="w-full h-auto object-cover pointer-events-none rounded-2xl border border-white/10 block"
                width="360"
                height="509"
                loading="lazy"
              />
            </div>
          ))}
        </div>

        <!-- Flecha Siguiente (Solo Escritorio) -->
        <button 
          id="coverflow-next" 
          class="hidden lg:flex absolute right-6 xl:right-12 z-[60] w-12 h-12 rounded-full bg-black/70 border border-purple-500/40 text-white items-center justify-center hover:bg-purple-600 hover:border-purple-400 transition-all shadow-[0_0_20px_rgba(139,92,246,0.4)] backdrop-blur-md"
          aria-label="Siguiente Formato"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>

      <!-- Barra inferior compacta: título + botón + info translúcido -->
      <div class="mt-4 sm:mt-6 flex flex-col items-center gap-2 z-30">
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="mobile-prev-btn"
            class="lg:hidden w-8 h-8 rounded-full bg-white/10 border border-white/15 flex items-center justify-center text-white active:scale-95"
            aria-label="Formato anterior"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
          </button>

          <h3 id="showcase-title" class="text-lg sm:text-2xl font-extrabold text-white tracking-wide uppercase min-w-[170px] sm:min-w-[240px] text-center">
            {SHOWCASE_FORMATS[0].title}
          </h3>

          <button
            type="button"
            id="mobile-next-btn"
            class="lg:hidden w-8 h-8 rounded-full bg-white/10 border border-white/15 flex items-center justify-center text-white active:scale-95"
            aria-label="Siguiente formato"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>

        <button
          type="button"
          id="showcase-open-popup"
          class="inline-flex items-center gap-1 px-4 py-1.5 rounded-full bg-purple-600/30 hover:bg-purple-600/55 border border-purple-400/45 text-purple-100 hover:text-white text-xs font-bold uppercase tracking-wider backdrop-blur-sm transition-all active:scale-95"
        >
          + info
        </button>
      </div>

    </div>
  </div>
</section>

<!-- POPUP MODAL INTERACTIVO ENCIMA DEL CARTEL -->
<div 
  id="showcase-popup" 
  class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/80 md:backdrop-blur-md opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="popup-title"
>
  <div 
    id="showcase-popup-card"
    class="relative w-full max-w-lg max-h-[88vh] overflow-y-auto rounded-3xl bg-[#13131C] border border-purple-500/40 shadow-[0_0_60px_rgba(139,92,246,0.45)] p-5 sm:p-7 text-left transform scale-95 transition-transform duration-200"
  >
    <!-- Botón Cerrar (X) -->
    <button
      type="button"
      id="popup-close"
      class="absolute top-4 right-4 w-9 h-9 rounded-full bg-white/10 hover:bg-purple-600 text-white flex items-center justify-center transition-colors z-20"
      aria-label="Cerrar ventana"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>

    <!-- Cabecera con Miniatura A4 completa y Título -->
    <div class="flex items-center gap-4 pr-10">
      <div class="w-16 sm:w-20 rounded-xl overflow-hidden border border-purple-500/40 flex-shrink-0 bg-black shadow-lg">
        <img id="popup-img" src="" alt="" class="w-full h-auto block" />
      </div>
      <div class="min-w-0">
        <span id="popup-eyebrow" class="text-[10px] sm:text-xs font-bold tracking-[0.2em] uppercase text-purple-300 block mb-1"></span>
        <h4 id="popup-title" class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight leading-none"></h4>
      </div>
    </div>

    <!-- Descripción -->
    <p id="popup-desc" class="mt-4 text-sm sm:text-base text-white/95 font-normal leading-relaxed"></p>

    <!-- Etiquetas Ideal Para -->
    <div id="popup-tags" class="mt-4 flex flex-wrap gap-1.5"></div>

    <!-- Reproductor SoundCloud (si el formato tiene audio) -->
    <div id="popup-audio-wrap" class="hidden mt-4 pt-3 border-t border-white/10">
      <div class="rounded-xl overflow-hidden border border-purple-500/40 bg-[#0B0B10]">
        <iframe id="popup-sc-iframe" width="100%" height="140" scrolling="no" frameborder="no" allow="autoplay" src="" loading="lazy"></iframe>
      </div>
      <a id="popup-sc-link" href="#" target="_blank" rel="noopener noreferrer" class="inline-block mt-1.5 text-xs text-purple-300 hover:text-white underline transition-colors">
        Abrir en SoundCloud &rarr;
      </a>
    </div>

    <!-- Acciones del Popup -->
    <div class="mt-6 pt-4 border-t border-white/10 flex flex-col sm:flex-row items-center gap-3">
      <a 
        id="popup-book"
        href="#contact" 
        class="btn-primary w-full sm:flex-1 text-xs sm:text-sm !py-3 !px-5 text-center"
      >
        RESERVAR FORMATO
      </a>
      <a 
        id="popup-page"
        href="#" 
        class="btn-secondary w-full sm:w-auto text-xs sm:text-sm !py-3 !px-5 text-center"
      >
        Ver ficha completa &rarr;
      </a>
    </div>
  </div>
</div>

<style>
  .coverflow-item {
    width: 220px;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.5s ease;
    will-change: transform, opacity;
    pointer-events: auto;
  }
  @media (min-width: 640px) {
    .coverflow-item {
      width: 285px;
    }
  }
  @media (min-width: 1200px) {
    .coverflow-item {
      width: 330px;
    }
  }

  /* 3D transforms: todos los carteles visibles en translateZ POSITIVO para que siempre reciban clicks por encima del plano Z=0 */
  .coverflow-item.active {
    transform: translateZ(140px) scale(1.04);
    opacity: 1;
    z-index: 50;
    box-shadow: 0 20px 45px rgba(0,0,0,0.85), 0 0 35px rgba(139,92,246,0.5);
    border: 2px solid #8B5CF6;
  }
  .coverflow-item.prev-1 {
    transform: translateX(-54%) translateZ(60px) rotateY(26deg) scale(0.84);
    opacity: 0.65;
    z-index: 30;
  }
  .coverflow-item.next-1 {
    transform: translateX(54%) translateZ(60px) rotateY(-26deg) scale(0.84);
    opacity: 0.65;
    z-index: 30;
  }
  .coverflow-item.prev-2 {
    transform: translateX(-86%) translateZ(15px) rotateY(36deg) scale(0.7);
    opacity: 0.28;
    z-index: 20;
  }
  .coverflow-item.next-2 {
    transform: translateX(86%) translateZ(15px) rotateY(-36deg) scale(0.7);
    opacity: 0.28;
    z-index: 20;
  }

  /* Tablet / Medium Desktop */
  @media (min-width: 768px) {
    .coverflow-item.prev-1 {
      transform: translateX(-78%) translateZ(60px) rotateY(28deg) scale(0.86);
      opacity: 0.74;
    }
    .coverflow-item.next-1 {
      transform: translateX(78%) translateZ(60px) rotateY(-28deg) scale(0.86);
      opacity: 0.74;
    }
    .coverflow-item.prev-2 {
      transform: translateX(-142%) translateZ(15px) rotateY(38deg) scale(0.72);
      opacity: 0.36;
    }
    .coverflow-item.next-2 {
      transform: translateX(142%) translateZ(15px) rotateY(-38deg) scale(0.72);
      opacity: 0.36;
    }
  }

  /* Large Desktop 1400px+ */
  @media (min-width: 1400px) {
    .coverflow-item.prev-1 {
      transform: translateX(-96%) translateZ(65px) rotateY(30deg) scale(0.88);
      opacity: 0.82;
    }
    .coverflow-item.next-1 {
      transform: translateX(96%) translateZ(65px) rotateY(-30deg) scale(0.88);
      opacity: 0.82;
    }
    .coverflow-item.prev-2 {
      transform: translateX(-182%) translateZ(20px) rotateY(40deg) scale(0.74);
      opacity: 0.45;
    }
    .coverflow-item.next-2 {
      transform: translateX(182%) translateZ(20px) rotateY(-40deg) scale(0.74);
      opacity: 0.45;
    }
  }

  .coverflow-item.hidden-item {
    transform: translateZ(-120px) scale(0.5);
    opacity: 0;
    z-index: 10;
    pointer-events: none;
  }
</style>

<script>
  let currentIndex = 0;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.coverflow-item'));
  const prevBtn = document.getElementById('coverflow-prev');
  const nextBtn = document.getElementById('coverflow-next');
  const mobilePrevBtn = document.getElementById('mobile-prev-btn');
  const mobileNextBtn = document.getElementById('mobile-next-btn');
  const openPopupBtn = document.getElementById('showcase-open-popup');
  const titleEl = document.getElementById('showcase-title');
  const stage = document.getElementById('coverflow-stage');

  // Popup elements
  const popup = document.getElementById('showcase-popup');
  const popupCard = document.getElementById('showcase-popup-card');
  const popupClose = document.getElementById('popup-close');
  const popupImg = document.getElementById('popup-img') as HTMLImageElement | null;
  const popupEyebrow = document.getElementById('popup-eyebrow');
  const popupTitle = document.getElementById('popup-title');
  const popupDesc = document.getElementById('popup-desc');
  const popupTags = document.getElementById('popup-tags');
  const popupAudioWrap = document.getElementById('popup-audio-wrap');
  const popupScIframe = document.getElementById('popup-sc-iframe') as HTMLIFrameElement | null;
  const popupScLink = document.getElementById('popup-sc-link') as HTMLAnchorElement | null;
  const popupBook = document.getElementById('popup-book');
  const popupPage = document.getElementById('popup-page') as HTMLAnchorElement | null;

  function updateCoverflow() {
    const total = items.length;
    if (total === 0) return;

    items.forEach((item, index) => {
      item.classList.remove('active', 'prev-1', 'next-1', 'prev-2', 'next-2', 'hidden-item');

      let offset = (index - currentIndex + total) % total;
      if (offset > total / 2) offset -= total;

      if (offset === 0) {
        item.classList.add('active');
        if (titleEl) titleEl.textContent = item.dataset.title || '';
      } else if (offset === -1) {
        item.classList.add('prev-1');
      } else if (offset === 1) {
        item.classList.add('next-1');
      } else if (offset === -2) {
        item.classList.add('prev-2');
      } else if (offset === 2) {
        item.classList.add('next-2');
      } else {
        item.classList.add('hidden-item');
      }
    });
  }

  function openPopup(item: HTMLElement) {
    if (!popup || !popupCard) return;

    const title = item.dataset.title || '';
    const eyebrow = item.dataset.eyebrow || '';
    const desc = item.dataset.desc || '';
    const img = item.dataset.image || '';
    const slug = item.dataset.slug || '';
    const embed = item.dataset.embed || '';
    const listen = item.dataset.listen || '';
    let ideal: string[] = [];
    try {
      ideal = JSON.parse(item.dataset.ideal || '[]');
    } catch {}

    if (popupImg) {
      popupImg.src = img;
      popupImg.alt = title;
    }
    if (popupEyebrow) popupEyebrow.textContent = eyebrow;
    if (popupTitle) popupTitle.textContent = title;
    if (popupDesc) popupDesc.textContent = desc;
    if (popupPage) popupPage.href = `/${slug}`;

    if (popupTags) {
      popupTags.innerHTML = ideal
        .map(tag => `<span class="px-2.5 py-1 rounded-full bg-purple-900/40 border border-purple-500/30 text-[11px] font-semibold text-purple-200">${tag}</span>`)
        .join('');
    }

    if (popupAudioWrap && popupScIframe && popupScLink) {
      if (embed) {
        popupScIframe.src = embed;
        popupScLink.href = listen;
        popupAudioWrap.classList.remove('hidden');
      } else {
        popupAudioWrap.classList.add('hidden');
        popupScIframe.src = '';
      }
    }

    popup.classList.remove('hidden');
    requestAnimationFrame(() => {
      popup.classList.remove('opacity-0');
      popupCard.classList.remove('scale-95');
      popupCard.classList.add('scale-100');
    });
    document.body.style.overflow = 'hidden';
  }

  function closePopup() {
    if (!popup || !popupCard) return;
    popup.classList.add('opacity-0');
    popupCard.classList.remove('scale-100');
    popupCard.classList.add('scale-95');
    setTimeout(() => {
      popup.classList.add('hidden');
      if (popupScIframe) popupScIframe.src = '';
      document.body.style.overflow = '';
    }, 200);
  }

  function goNext() {
    currentIndex = (currentIndex + 1) % items.length;
    updateCoverflow();
  }

  function goPrev() {
    currentIndex = (currentIndex - 1 + items.length) % items.length;
    updateCoverflow();
  }

  prevBtn?.addEventListener('click', goPrev);
  nextBtn?.addEventListener('click', goNext);
  mobilePrevBtn?.addEventListener('click', goPrev);
  mobileNextBtn?.addEventListener('click', goNext);

  openPopupBtn?.addEventListener('click', () => {
    const activeItem = items[currentIndex];
    if (activeItem) openPopup(activeItem);
  });

  items.forEach((item, index) => {
    item.addEventListener('click', (e) => {
      e.stopPropagation();
      if (index === currentIndex) {
        openPopup(item);
      } else {
        currentIndex = index;
        updateCoverflow();
      }
    });
  });

  popupClose?.addEventListener('click', closePopup);
  popupBook?.addEventListener('click', closePopup);
  popup?.addEventListener('click', (e) => {
    if (e.target === popup) closePopup();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && popup && !popup.classList.contains('hidden')) {
      closePopup();
    }
  });

  // Touch Swipe Gesture Support
  let touchStartX = 0;
  let touchEndX = 0;

  stage?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  stage?.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 40) {
      if (diff > 0) goNext();
      else goPrev();
    }
  }, { passive: true });

  // Initialize
  updateCoverflow();
</script>
