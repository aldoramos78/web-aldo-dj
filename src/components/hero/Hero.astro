---
---
<section id="hero" class="relative w-full min-h-[100svh] lg:h-[100dvh] lg:max-h-[100dvh] flex flex-col justify-between items-center overflow-hidden pt-16 sm:pt-20 lg:pt-20 pb-0">
  
  <!-- ISOTIPO GIGANTE A PANTALLA COMPLETA EN BLANCO SÓLIDO (Visible en z-0 con presencia monumental) -->
  <div class="absolute top-[46%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] sm:w-[580px] md:w-[740px] lg:w-[880px] xl:w-[980px] aspect-square flex items-center justify-center pointer-events-none z-0 opacity-60 lg:opacity-65 select-none">
    <!-- Halo suave de resplandor morado ambiental -->
    <div class="absolute inset-0 bg-[radial-gradient(circle,rgba(168,85,247,0.35)_0%,rgba(59,130,246,0.15)_45%,transparent_70%)] blur-3xl"></div>
    
    <!-- Imagen del Isotipo en Blanco Puro Gigante -->
    <img 
      src="/imagenes/Iso.DJ.png" 
      alt="Aldo Deejay Isotipo" 
      class="w-full h-full object-contain filter brightness-0 invert drop-shadow-[0_0_40px_rgba(255,255,255,0.85)] drop-shadow-[0_0_90px_rgba(168,85,247,0.6)]"
      width="1080"
      height="1080"
      loading="eager"
    />
  </div>

  <!-- CONTENEDOR PRINCIPAL DEL HERO (Alineado para caber 100% en la pantalla) -->
  <div class="w-full max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8 text-center flex-1 flex flex-col justify-center items-center z-10 py-2 sm:py-3 my-auto">
    
    <!-- Badge de Localización: Fuerteventura • Canary Islands -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/75 border border-purple-500/35 backdrop-blur-md mb-2 lg:mb-3 text-[10px] sm:text-xs uppercase tracking-[0.25em] text-gray-300 font-semibold shadow-[0_0_15px_rgba(139,92,246,0.25)]">
      <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse shadow-[0_0_6px_#c084fc]"></span>
      Fuerteventura &bull; Canary Islands
    </div>

    <!-- H1 Semántico con la Fuente Serif Itálica Editorial en UNA LÍNEA en Web + Efecto Tornasol -->
    <h1 class="hero-subtitulo font-serif italic font-normal text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] xl:text-[3.1rem] lg:whitespace-nowrap tracking-wide select-none mb-4 lg:mb-6">
      &ldquo;El arte de crear la atm&oacute;sfera perfecta.&rdquo;
    </h1>

    <!-- ESCENARIO CENTRAL INTERACTIVO (Telemetría de audio flotando sobre el gran Isotipo) -->
    <div class="relative w-full max-w-[500px] sm:max-w-[650px] lg:max-w-[760px] flex items-center justify-center my-2 lg:my-3 select-none">
      
      <!-- NODOS ORBITALES EN DESKTOP / TABLET (Con luz intermitente en los 3) -->
      
      <!-- Nodo 1: Izquierda (Sunset Afro House con luz intermitente ámbar) -->
      <div class="hidden sm:flex flex-col items-end absolute -left-10 lg:-left-16 xl:-left-20 top-1/2 -translate-y-1/2 z-20 group">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0E0C13]/90 border border-amber-500/50 backdrop-blur-md shadow-[0_0_15px_rgba(251,191,36,0.25)] hover:border-amber-400 transition-colors">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
          </span>
          <span class="text-xs font-mono font-bold tracking-wider text-amber-300 uppercase">
            SUNSET AFRO HOUSE
          </span>
        </div>
        <div class="text-[11px] font-mono text-gray-400 mt-1.5 text-right tracking-tight">
          118&ndash;122 BPM &bull; Organic Chords
        </div>
      </div>

      <!-- Nodo 2: Derecha Arriba (Balearic & Organic con luz intermitente cian) -->
      <div class="hidden sm:flex flex-col items-start absolute -right-10 lg:-right-16 xl:-right-20 top-0 z-20 group">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0E0C13]/90 border border-cyan-500/50 backdrop-blur-md shadow-[0_0_15px_rgba(34,211,238,0.25)] hover:border-cyan-400 transition-colors">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
          </span>
          <span class="text-xs font-mono font-bold tracking-wider text-cyan-300 uppercase">
            BALEARIC &amp; ORGANIC
          </span>
        </div>
        <div class="text-[11px] font-mono text-gray-400 mt-1.5 text-left tracking-tight">
          Lush Grooves &bull; Luxury Resorts
        </div>
      </div>

      <!-- Nodo 3: Derecha Abajo (Peak Hour Climax con luz intermitente púrpura) -->
      <div class="hidden sm:flex flex-col items-start absolute -right-8 lg:-right-14 xl:-right-16 bottom-0 z-20 group">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0E0C13]/90 border border-purple-500/50 backdrop-blur-md shadow-[0_0_15px_rgba(192,132,252,0.25)] hover:border-purple-400 transition-colors">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-400"></span>
          </span>
          <span class="text-xs font-mono font-bold tracking-wider text-purple-300 uppercase">
            PEAK HOUR CLIMAX
          </span>
        </div>
        <div class="text-[11px] font-mono text-gray-400 mt-1.5 text-left tracking-tight">
          Melodic Waves &bull; Pure Energy
        </div>
      </div>

      <!-- Espacio central transparente que deja ver el gran Isotipo de fondo -->
      <div class="w-full h-16 sm:h-24 lg:h-28 pointer-events-none"></div>

    </div>

    <!-- NODOS COMPACTOS EN MÓVIL (<640px): Ticker horizontal adaptativo con luz intermitente -->
    <div class="flex sm:hidden flex-wrap items-center justify-center gap-2 mb-3 max-w-sm mx-auto">
      <span class="inline-flex items-center gap-1.5 text-[10px] font-mono font-semibold uppercase text-amber-300 bg-black/75 px-2.5 py-1 rounded-full border border-amber-500/35">
        <span class="relative flex h-1.5 w-1.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-amber-400"></span>
        </span>
        Sunset Afro House
      </span>
      <span class="inline-flex items-center gap-1.5 text-[10px] font-mono font-semibold uppercase text-cyan-300 bg-black/75 px-2.5 py-1 rounded-full border border-cyan-500/35">
        <span class="relative flex h-1.5 w-1.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-cyan-400"></span>
        </span>
        Balearic &amp; Organic
      </span>
      <span class="inline-flex items-center gap-1.5 text-[10px] font-mono font-semibold uppercase text-purple-300 bg-black/75 px-2.5 py-1 rounded-full border border-purple-500/35">
        <span class="relative flex h-1.5 w-1.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-purple-400"></span>
        </span>
        Peak Hour Climax
      </span>
    </div>

    <!-- REPRODUCTOR MINI-PLAYER FLOTANTE -->
    <div class="w-full max-w-xl mx-auto glass-panel rounded-2xl p-2.5 sm:p-3.5 border border-purple-500/30 shadow-[0_10px_35px_rgba(0,0,0,0.85),0_0_25px_rgba(139,92,246,0.25)] relative z-30 my-2 lg:my-2.5">
      <div class="flex items-center gap-3 sm:gap-4">
        
        <!-- Botón Play/Pause Interactivo -->
        <button 
          id="hero-play-btn"
          aria-label="Reproducir adelanto de Creep"
          class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-gradient-to-tr from-cyan-500 via-indigo-600 to-purple-600 flex-shrink-0 flex items-center justify-center text-white shadow-[0_0_16px_rgba(34,211,238,0.5)] hover:scale-105 active:scale-95 transition-all group focus:outline-none"
        >
          <!-- Play Icon -->
          <svg id="hero-play-icon" class="w-5 h-5 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
          <!-- Pause Icon (oculto por defecto) -->
          <svg id="hero-pause-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
          </svg>
        </button>

        <!-- Track Info + Barra de Progreso -->
        <div class="flex-1 min-w-0 text-left">
          <div class="flex items-center justify-between gap-2 mb-1">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded text-[9px] sm:text-[10px] font-mono font-bold tracking-wider bg-purple-950/80 text-purple-300 uppercase border border-purple-500/40">
                NOW PLAYING
              </span>
              <span class="text-[10px] sm:text-xs font-mono font-semibold text-cyan-400">
                122 BPM
              </span>
            </div>
            <!-- Vúmetro / Barras de ecualizador animadas -->
            <div class="flex items-end gap-1 h-3.5" id="hero-equalizer">
              <span class="w-1 bg-cyan-400 rounded-full h-2 animate-pulse"></span>
              <span class="w-1 bg-purple-400 rounded-full h-3.5 animate-pulse" style="animation-delay: 150ms"></span>
              <span class="w-1 bg-fuchsia-400 rounded-full h-1.5 animate-pulse" style="animation-delay: 300ms"></span>
              <span class="w-1 bg-cyan-400 rounded-full h-3 animate-pulse" style="animation-delay: 450ms"></span>
            </div>
          </div>

          <!-- Título exacto de la canción con link a la página de Creep -->
          <a href="/creep" class="block text-xs sm:text-sm font-bold text-white hover:text-purple-300 transition-colors truncate">
            Creep (Afro House) &ndash; feat. Yami Gonz&aacute;lez
          </a>

          <!-- Barra de progreso -->
          <div class="mt-1 flex items-center gap-2 text-[9px] sm:text-[10px] font-mono text-gray-400">
            <span id="hero-track-time">02:14</span>
            <div class="flex-1 h-1.5 bg-black/60 rounded-full overflow-hidden border border-white/10">
              <div id="hero-progress-bar" class="h-full bg-gradient-to-r from-cyan-400 via-indigo-500 to-fuchsia-500 w-[38%] rounded-full transition-all duration-300"></div>
            </div>
            <span>05:38</span>
          </div>
        </div>

      </div>
    </div>

    <!-- ÚNICO CTA CENTRADO (Eliminado Reservar Fecha) -->
    <div class="mt-3 lg:mt-4 flex items-center justify-center w-full">
      <a 
        href="#sets" 
        class="inline-flex items-center justify-center gap-2.5 px-10 sm:px-12 py-3 sm:py-3.5 rounded-full font-bold uppercase tracking-wider text-xs sm:text-sm text-white bg-gradient-to-r from-purple-600 via-indigo-600 to-cyan-500 hover:from-purple-500 hover:to-cyan-400 shadow-[0_0_30px_rgba(139,92,246,0.65)] hover:shadow-[0_0_40px_rgba(34,211,238,0.7)] transition-all hover:-translate-y-0.5 active:translate-y-0"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        Escuchar Sets
      </a>
    </div>

  </div>

  <!-- BANNER SEPARADOR DEL HERO (Ligado a la base del Hero marcando la separación con el contenido principal) -->
  <div class="w-full border-t border-purple-500/25 bg-[#09080E]/95 backdrop-blur-md py-2.5 sm:py-3 px-4 sm:px-8 mt-auto z-20 select-none">
    <div class="max-w-[1600px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 sm:gap-4 text-xs font-mono text-gray-300">
      
      <!-- Micro-estadísticas en directo con separador morado -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-center">
        <span class="inline-flex items-center gap-1.5">
          <strong class="text-purple-400 font-bold tracking-tight">+15</strong>
          <span class="text-gray-300">Años de trayectoria</span>
        </span>

        <span class="text-purple-500/50 font-sans hidden sm:inline">|</span>

        <span class="inline-flex items-center gap-1.5">
          <strong class="text-purple-400 font-bold tracking-tight">6</strong>
          <span class="text-gray-300">Formatos Escénicos</span>
        </span>

        <span class="text-purple-500/50 font-sans hidden sm:inline">|</span>

        <span class="inline-flex items-center gap-1.5">
          <strong class="text-purple-400 font-bold tracking-tight">PRO</strong>
          <span class="text-gray-300">Rider Técnico Pro</span>
        </span>
      </div>

      <!-- Copyright / Telemetría derecha con año 2026 -->
      <div class="text-[10px] sm:text-xs text-gray-500 tracking-wider">
        &copy; 2026 ALDO DEEJAY. TODOS LOS DERECHOS RESERVADOS.
      </div>

    </div>
  </div>

</section>

<style>
  /* Efecto tornasol / cristal prismático en tonos morados, plata y fucsia */
  .hero-subtitulo {
    background: linear-gradient(135deg, #FFFFFF 0%, #F3E8FF 25%, #C084FC 50%, #E879F9 70%, #A855F7 88%, #FFFFFF 100%);
    background-size: 220% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 14px rgba(168, 85, 247, 0.45));
    animation: tornasol-shine 7s ease-in-out infinite alternate;
  }

  @keyframes tornasol-shine {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 100% 50%;
    }
  }
</style>

<script>
  // Mini reproductor interactivo
  const playBtn = document.getElementById('hero-play-btn');
  const playIcon = document.getElementById('hero-play-icon');
  const pauseIcon = document.getElementById('hero-pause-icon');
  const progressBar = document.getElementById('hero-progress-bar');
  const timeDisplay = document.getElementById('hero-track-time');
  const equalizer = document.getElementById('hero-equalizer');
  
  let isPlaying = false;
  let seconds = 134; // 02:14
  let playInterval: any = null;

  function formatTime(s: number) {
    const mins = Math.floor(s / 60);
    const secs = s % 60;
    return `0${mins}:${secs < 10 ? '0' + secs : secs}`;
  }

  playBtn?.addEventListener('click', () => {
    isPlaying = !isPlaying;

    if (isPlaying) {
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');

      playInterval = setInterval(() => {
        seconds++;
        if (seconds >= 338) { // 05:38
          seconds = 134;
        }
        if (timeDisplay) timeDisplay.textContent = formatTime(seconds);
        if (progressBar) progressBar.style.width = `${(seconds / 338) * 100}%`;
      }, 1000);

      // Activar animación en barras del ecualizador
      equalizer?.querySelectorAll('span').forEach(bar => {
        bar.classList.add('animate-pulse');
      });
    } else {
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');
      clearInterval(playInterval);

      // Desactivar animación en barras del ecualizador
      equalizer?.querySelectorAll('span').forEach(bar => {
        bar.classList.remove('animate-pulse');
      });
    }
  });
</script>
