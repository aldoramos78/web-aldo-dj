---
---
<section id="contact" class="py-20 sm:py-28 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-panel rounded-3xl p-8 sm:p-12 lg:p-14 border border-purple-500/30 shadow-[0_0_50px_rgba(139,92,246,0.25)] relative overflow-hidden">
      
      <!-- Background Glow -->
      <div class="absolute -top-20 -right-20 w-72 h-72 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="text-center mb-10 relative z-10">
        <span class="text-xs sm:text-sm font-bold tracking-[0.3em] text-[#A78BFA] uppercase block mb-3">
          Reserva de Fecha & Contratación
        </span>
        <h2 class="section-title !mb-4">
          CONTACTO
        </h2>
        <div class="mx-auto w-36 h-[3px] rounded-full bg-gradient-to-r from-transparent via-[#8B5CF6] to-transparent shadow-[0_0_16px_rgba(139,92,246,0.9)] mb-5"></div>
        <p class="text-gray-300 max-w-xl mx-auto text-base sm:text-lg font-light">
          Cuéntame qué tipo de evento estás preparando, fecha y lugar en Fuerteventura o Canarias. Te responderé con disponibilidad y opciones.
        </p>
      </div>

      <!-- Quick WhatsApp Channel -->
      <div class="mb-8 text-center">
        <a 
          href="https://wa.me/34600000000?text=Hola%20Aldo,%20me%20gustar%C3%ADa%20consultar%20disponibilidad%20para%20un%20evento" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-emerald-600/20 border border-emerald-500/50 text-emerald-300 hover:bg-emerald-600/30 transition-all text-xs font-semibold uppercase tracking-wider"
        >
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.071.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z"/></svg>
          Chat Directo vía WhatsApp para Consulta Rápida
        </a>
      </div>

      <!-- Booking Form -->
      <form id="booking-form" class="space-y-6 relative z-10" action="https://formspree.io/f/placeholder" method="POST">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="contact-name" class="block text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2">
              Nombre o Empresa *
            </label>
            <input 
              type="text" 
              id="contact-name" 
              name="name" 
              required 
              placeholder="Ej. Hotel / Pareja / Particular"
              class="w-full px-4 py-3 rounded-xl bg-black/50 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2">
              Email de Contacto *
            </label>
            <input 
              type="email" 
              id="contact-email" 
              name="email" 
              required 
              placeholder="tuemail@ejemplo.com"
              class="w-full px-4 py-3 rounded-xl bg-black/50 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div>
            <label for="contact-phone" class="block text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2">
              Teléfono
            </label>
            <input 
              type="tel" 
              id="contact-phone" 
              name="phone" 
              placeholder="+34 600 000 000"
              class="w-full px-4 py-3 rounded-xl bg-black/50 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm"
            />
          </div>

          <div>
            <label for="contact-event-type" class="block text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2">
              Tipo de Evento *
            </label>
            <select 
              id="contact-event-type" 
              name="eventType" 
              required 
              class="w-full px-4 py-3 rounded-xl bg-[#1A1A22] border border-white/10 text-white focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm"
            >
              <option value="" disabled selected>Selecciona una opción...</option>
              <option value="hotel">Hotel / Terraza / Piscina</option>
              <option value="wedding">Boda / Celebración</option>
              <option value="club">Fiesta / Noche / Bar</option>
              <option value="showcase">Espectáculo Especial (Octopus / Flamenco Grooves / Deep Blue Sea)</option>
              <option value="other">Otro Formato</option>
            </select>
          </div>

          <div>
            <label for="contact-date" class="block text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2">
              Fecha Prevista
            </label>
            <input 
              type="date" 
              id="contact-date" 
              name="date" 
              class="w-full px-4 py-3 rounded-xl bg-black/50 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm"
            />
          </div>
        </div>

        <div>
          <label for="contact-location" class="block text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2">
            Localización (Municipio, Hotel o Espacio en Fuerteventura / Canarias)
          </label>
          <input 
            type="text" 
            id="contact-location" 
            name="location" 
            placeholder="Ej. Corralejo / Morro Jable / Caleta de Fuste / Playa Blanca (Lanzarote)"
            class="w-full px-4 py-3 rounded-xl bg-black/50 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm"
          />
        </div>

        <div>
          <label for="contact-message" class="block text-xs uppercase tracking-wider text-gray-300 font-semibold mb-2">
            Detalles y Necesidades
          </label>
          <textarea 
            id="contact-message" 
            name="message" 
            rows="4" 
            placeholder="Coméntame horarios aproximados, si el espacio dispone de equipo o si necesitas que aportemos sonido e iluminación..."
            class="w-full px-4 py-3 rounded-xl bg-black/50 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm"
          ></textarea>
        </div>

        <div class="flex items-start gap-3 pt-2">
          <input 
            type="checkbox" 
            id="contact-privacy" 
            name="privacy" 
            required 
            class="mt-1 rounded border-gray-700 text-purple-600 focus:ring-purple-500 bg-black/50"
          />
          <label for="contact-privacy" class="text-xs text-gray-400 leading-relaxed">
            He leído y acepto la <a href="/politica-de-privacidad" class="text-purple-400 underline hover:text-purple-300">política de privacidad</a>. La información será tratada por VIP CRAB EVENTS, S.L.U. exclusivamente para responder a tu consulta.
          </label>
        </div>

        <div class="text-center pt-4">
          <button type="submit" class="btn-primary w-full sm:w-auto text-sm !py-3.5 !px-10">
            Enviar Consulta de Disponibilidad
          </button>
        </div>
      </form>

    </div>
  </div>
</section>
