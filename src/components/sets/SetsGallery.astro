    venueTag: "VIP CRAB Backed",
    dotColor: "bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.8)]",
    image: "/imagenes/Portada.Bodas.webp",
    badges: ["LUXURY WEDDINGS", "CORPORATE VIP", "COCKTAIL & PARTY"],
