---
/**
 * Hero — Aldo Deejay
 * Mobile first · sin dependencias · Astro 5
 */
import TeaserPlayer from '../TeaserPlayer.astro';

interface Props {
  isoSrc?: string;
  headerHeight?: string;
  bpm?: number;
  schema?: boolean;
  instagram?: string;
}

const {
  isoSrc = '/imagenes/Iso.DJ.png',
  headerHeight = '5rem',
  bpm = 122,
  schema = false,
  instagram = 'https://www.instagram.com/aldo.deejay/',
} = Astro.props;

// Todo el movimiento va a tempo: 1 pulso = 60 / BPM segundos
const beat = `${(60 / bpm).toFixed(4)}s`;

const bandA = [
  'Poolside Vibes',
  'Clubbing & Fest',
  'Premium Events',
  'Featurings',
  'Fuerteventura',
  'Islas Canarias',
];
const bandB = [
  'Afro House',
  'Latin House',
  'Hoteles & Resorts',
  'Bodas',
  'Beach Clubs',
  'Eventos privados',
  'Sunset Sessions',
];
---

<section
  id="hero"
  class="hero"
  aria-labelledby="hero-title"
  style={`--beat:${beat};--iso:url("${isoSrc}");--header-h:${headerHeight}`}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..800&family=Bodoni+Moda:ital,opsz,wght@1,6..96,400..700&display=swap"
  />

  <div class="hero__inner">
    <!-- ESCENARIO CLAUDE (ISO + HORIZONTE + REFLEJO + ANILLOS) + BOTONES FLOTANTES ALREDEDOR DEL LOGO -->
    <div class="stage" aria-hidden="true">
      <div class="stage__glow"></div>
      <div class="stage__rings"><span></span><span></span><span></span><span></span></div>
      <div class="stage__iso iso"></div>
      <div class="stage__horizon"></div>
      <div class="stage__reflect"><div class="iso"></div></div>

      <!-- Botones Flotantes con Balizas Intermitentes (100% responsivos en móvil y PC alrededor del logo) -->
      <!-- Nodo 1: Izquierda (Sunset Afro House con luz intermitente ámbar) -->
      <div class="flex flex-col items-end absolute -left-2 sm:-left-6 top-[32%] -translate-y-1/2 z-30 group pointer-events-auto">
        <div class="inline-flex items-center gap-1 sm:gap-2 px-2 sm:px-3 py-0.5 sm:py-1.5 rounded-full bg-[#0E0C13]/90 border border-amber-500/50 backdrop-blur-md shadow-[0_0_15px_rgba(251,191,36,0.25)] hover:border-amber-400 transition-colors">
          <span class="relative flex h-1.5 sm:h-2 w-1.5 sm:w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 sm:h-2 w-1.5 sm:w-2 bg-amber-400"></span>
          </span>
          <span class="text-[8px] sm:text-[11px] font-mono font-bold tracking-wider text-amber-300 uppercase whitespace-nowrap">
            SUNSET AFRO HOUSE
          </span>
        </div>
        <div class="text-[7.5px] sm:text-[10px] font-mono text-gray-400 mt-0.5 sm:mt-1 text-right tracking-tight whitespace-nowrap">
          Golden Hour &bull; Organic Chords
        </div>
      </div>

      <!-- Nodo 2: Derecha Arriba (Balearic & Organic con luz intermitente cian) -->
      <div class="flex flex-col items-start absolute -right-2 sm:-right-2 top-[10%] sm:top-[16%] z-30 group pointer-events-auto">
        <div class="inline-flex items-center gap-1 sm:gap-2 px-2 sm:px-3 py-0.5 sm:py-1.5 rounded-full bg-[#0E0C13]/90 border border-cyan-500/50 backdrop-blur-md shadow-[0_0_15px_rgba(34,211,238,0.25)] hover:border-cyan-400 transition-colors">
          <span class="relative flex h-1.5 sm:h-2 w-1.5 sm:w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 sm:h-2 w-1.5 sm:w-2 bg-cyan-400"></span>
          </span>
          <span class="text-[8px] sm:text-[11px] font-mono font-bold tracking-wider text-cyan-300 uppercase whitespace-nowrap">
            BALEARIC &amp; ORGANIC
          </span>
        </div>
        <div class="text-[7.5px] sm:text-[10px] font-mono text-gray-400 mt-0.5 sm:mt-1 text-left tracking-tight whitespace-nowrap">
          Lush Grooves &bull; Luxury Resorts
        </div>
      </div>

      <!-- Nodo 3: Derecha Medio (Peak Hour Climax) - Posicionado arriba, completamente fuera del reflejo y del horizonte -->
      <div class="flex flex-col items-start absolute -right-2 sm:-right-1 top-[48%] sm:top-[50%] z-30 group pointer-events-auto">
        <div class="inline-flex items-center gap-1 sm:gap-2 px-2 sm:px-3 py-0.5 sm:py-1.5 rounded-full bg-[#0E0C13]/90 border border-purple-500/50 backdrop-blur-md shadow-[0_0_15px_rgba(192,132,252,0.25)] hover:border-purple-400 transition-colors">
          <span class="relative flex h-1.5 sm:h-2 w-1.5 sm:w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 sm:h-2 w-1.5 sm:w-2 bg-purple-400"></span>
          </span>
          <span class="text-[8px] sm:text-[11px] font-mono font-bold tracking-wider text-purple-300 uppercase whitespace-nowrap">
            PEAK HOUR CLIMAX
          </span>
        </div>
        <div class="text-[7.5px] sm:text-[10px] font-mono text-gray-400 mt-0.5 sm:mt-1 text-left tracking-tight whitespace-nowrap">
          Melodic Waves &bull; Pure Energy
        </div>
      </div>

    </div>

    <!-- COLUMNA COPY (Centrado en móvil, alineado a la izquierda en desktop, sube sobre reflejo en móvil) -->
    <div class="copy">
      
      <!-- 1. Localización (Formato compacto y fino) -->
      <div class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-0.5 sm:py-1 rounded-full bg-black/60 border border-purple-500/30 backdrop-blur-md text-[8.5px] sm:text-[10px] uppercase tracking-[0.2em] sm:tracking-[0.22em] text-gray-300 font-medium shadow-[0_0_12px_rgba(139,92,246,0.2)] mb-0.5 sm:mb-1">
        <span class="w-1 h-1 rounded-full bg-purple-400 animate-pulse shadow-[0_0_4px_#c084fc]"></span>
        Fuerteventura &bull; Canary Islands
      </div>

      <!-- H1 Semántico Editorial Bodoni Moda que aprovecha toda la pantalla hasta casi los bordes -->
      <h1 id="hero-title" class="slogan w-full">
        El arte de crear la <em>atmósfera</em> perfecta.
      </h1>

      <!-- Subtítulo técnico proporcionado y menor que el H1, con margen coherente -->
      <p class="text-[9.5px] sm:text-xs uppercase tracking-[0.22em] sm:tracking-[0.26em] text-purple-300/85 font-medium max-w-lg mt-2 sm:mt-3 mb-1 sm:mb-2">
        DJ para Hoteles, Bodas y Eventos Privados
      </p>

      <!-- Telemetría de Trayectoria y Formatos en cápsula redondeada -->
      <div class="inline-flex flex-wrap items-center justify-center sm:justify-start gap-1.5 sm:gap-3 py-1.5 px-3.5 sm:px-5 rounded-full bg-black/60 border border-purple-500/30 backdrop-blur-md text-[10px] sm:text-sm font-mono text-gray-300 shadow-[0_4px_20px_rgba(0,0,0,0.5)] mb-1 sm:mb-2">
        <span class="inline-flex items-center gap-1.5">
          <strong class="text-purple-400 font-bold tracking-tight">+15</strong>
          <span>Años de trayectoria</span>
        </span>
        <span class="text-purple-500/60 font-sans">|</span>
        <span class="inline-flex items-center gap-1.5">
          <strong class="text-purple-400 font-bold tracking-tight">6</strong>
          <span>Formatos Escénicos</span>
        </span>
        <span class="text-purple-500/60 font-sans">|</span>
        <span class="inline-flex items-center gap-1.5">
          <strong class="text-purple-400 font-bold tracking-tight">PRO</strong>
          <span>Rider Técnico Pro</span>
        </span>
      </div>

      <!-- 2. Reproductor TeaserPlayer justo debajo del banner +15 años -->
      <div class="w-full flex justify-center sm:justify-start pt-1 sm:pt-1.5">
        <slot>
          <TeaserPlayer src="/audio/creep-teaser.mp3" />
        </slot>
      </div>

    </div>

  </div>

  <!-- CTA Centrado Inferior del Hero, justo encima de las cintas sin pisarse -->
  <div class="hero__cta w-full flex justify-center items-center z-20 pt-1 pb-3 sm:pb-4 pointer-events-auto">
    <a 
      href="#sets" 
      class="btn-primary text-xs sm:text-sm !py-3 !px-10 sm:!px-14 uppercase font-bold tracking-wider shadow-[0_0_25px_rgba(139,92,246,0.65)] hover:shadow-[0_0_35px_rgba(139,92,246,0.9)] hover:scale-105 active:scale-95 transition-all text-center"
    >
      ESCÚCHAME
    </a>
  </div>

  <!-- CINTAS SEPARADORAS MARQUEE CRUZADAS A TEMPO -->
  <div class="bands" aria-hidden="true">
    <div class="band band--b">
      <div class="band__track band__track--rev">
        {[0, 1].map(() => bandB.map((t) => (<span class="band__item">{t}<span class="glyph"></span></span>)))}
      </div>
    </div>
    <div class="band band--a">
      <div class="band__track">
        {[0, 1].map(() => bandA.map((t) => (<span class="band__item">{t}<span class="glyph"></span></span>)))}
      </div>
    </div>
  </div>

</section>

<style>
  /* Paleta violeta: #7C3AED, #8B5CF6, #A78BFA sobre #08080C */
  .hero,
  .hero *,
  .hero *::before,
  .hero *::after {
    box-sizing: border-box;
  }
  .hero {
    --night: #08080c;
    --night-2: #140c22;
    --ink: #f5f2ff;
    --line: rgba(196, 181, 253, 0.18);
    --violet: #7c3aed;
    --violet-2: #8b5cf6;
    --lila: #a78bfa;
    --lavanda: #c4b5fd;
    --f-display: 'Bodoni Moda', 'Bodoni 72', Didot, Georgia, serif;
    --f-sans: 'Archivo', 'Helvetica Neue', Arial, sans-serif;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    color: var(--ink);
    font-family: var(--f-sans);
    background:
      radial-gradient(120% 60% at 50% 100%, rgba(124, 58, 237, 0.3), transparent 62%),
      radial-gradient(80% 50% at 0% 0%, rgba(167, 139, 250, 0.08), transparent 60%),
      linear-gradient(180deg, var(--night) 0%, var(--night-2) 100%);
  }

  .hero__inner {
    flex: 1;
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    padding-inline: 0.75rem;
    padding-top: calc(var(--header-h) + 0.25rem);
    padding-bottom: 0.25rem;
    display: grid;
    grid-template-areas: 'stage' 'copy';
    gap: 0;
    align-content: center;
  }
  @media (min-width: 640px) {
    .hero__inner {
      padding-inline: 1.5rem;
      padding-top: calc(var(--header-h) + 0.5rem);
      padding-bottom: 0.5rem;
      gap: 1rem;
    }
  }
  @media (min-width: 1024px) {
    .hero__inner {
      padding-inline: 2.5rem;
    }
  }
  @media (min-width: 1280px) {
    .hero__inner {
      padding-inline: 3.5rem;
    }
  }

  /* — Título y Contenido: Centrado en móvil, alineado a la izquierda en desktop — */
  .copy {
    grid-area: copy;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.45rem;
    margin-top: -0.5rem; /* Cuadra justo en el borde inferior del reflejo */
    position: relative;
    z-index: 10;
    animation: up 0.9s 0.25s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }
  @media (min-width: 640px) {
    .copy {
      margin-top: -0.5rem;
      gap: 0.65rem;
    }
  }
  @media (min-width: 960px) {
    .copy {
      align-items: flex-start;
      text-align: left;
      margin-top: 0;
      gap: 0.75rem;
    }
  }

  .slogan {
    margin: 0;
    width: 100%;
    font-family: var(--f-display);
    font-style: italic;
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(2.35rem, 8.8vw, 3.8rem);
    line-height: 0.96;
    letter-spacing: -0.025em;
    text-wrap: balance;
    text-align: center;
    padding-inline: 0.15rem;
  }
  @media (min-width: 960px) {
    .slogan {
      text-align: left;
      font-size: clamp(3.4rem, 5.6vw, 5.8rem);
      line-height: 0.98;
      padding-inline: 0;
    }
  }
  .slogan em {
    font-style: italic;
    padding-inline-end: 0.06em;
    background: linear-gradient(90deg, var(--violet-2), var(--lila) 50%, #ede9fe);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* — Escenario: iso, resplandor, horizonte y reflejo — */
  .stage {
    grid-area: stage;
    position: relative;
    width: min(74vw, min(32vh, 250px));
    max-width: 100%;
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .iso {
    -webkit-mask: var(--iso) center / contain no-repeat;
    mask: var(--iso) center / contain no-repeat;
    aspect-ratio: 3399 / 3133;
  }
  .stage__iso {
    position: absolute;
    left: 10%;
    width: 80%;
    top: 6%;
    background: linear-gradient(180deg, var(--ink) 0%, #ddd0ff 45%, var(--violet-2) 100%);
    filter: drop-shadow(0 0 1.5rem rgba(139, 92, 246, 0.55));
    animation: rise 1.3s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }
  .stage__glow {
    position: absolute;
    left: 50%;
    top: 79.7%;
    width: 92%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.6) 0%, rgba(167, 139, 250, 0.28) 38%, transparent 68%);
    will-change: transform, opacity;
    transform: translateZ(0);
    animation: beat var(--beat) ease-out infinite;
  }
  .stage__rings span {
    position: absolute;
    left: 50%;
    top: 79.7%;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid var(--line);
    translate: -50% -50%;
    opacity: 0;
    will-change: transform, opacity;
    transform: translateZ(0);
    animation: ring calc(var(--beat) * 8) linear infinite;
  }
  .stage__rings span:nth-child(2) { animation-delay: calc(var(--beat) * -2); }
  .stage__rings span:nth-child(3) { animation-delay: calc(var(--beat) * -4); }
  .stage__rings span:nth-child(4) { animation-delay: calc(var(--beat) * -6); }

  .stage__horizon {
    position: absolute;
    left: -30%;
    right: -30%;
    top: 79.7%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--violet) 30%, var(--ink) 50%, var(--lila) 70%, transparent);
  }
  .stage__reflect {
    position: absolute;
    left: 10%;
    width: 80%;
    top: calc(79.7% + 2px);
    bottom: -8%;
    overflow: hidden;
    opacity: 0.45;
    -webkit-mask: linear-gradient(180deg, #000 0%, transparent 85%);
    mask: linear-gradient(180deg, #000 0%, transparent 85%);
  }
  .stage__reflect .iso {
    width: 100%;
    transform: scaleY(-1);
    background: linear-gradient(0deg, var(--violet), var(--lila));
    will-change: transform;
    animation: ripple calc(var(--beat) * 4) ease-in-out infinite;
  }

  /* — Separador: dos cintas de escenario cruzadas — */
  .bands {
    position: relative;
    height: 4.6rem;
    flex: none;
    margin-top: auto;
    overflow: clip;
    pointer-events: none;
  }
  .band {
    position: absolute;
    left: -5%;
    width: 110%;
    overflow: hidden;
    padding-block: 0.38rem;
  }
  .band--a {
    top: 1.85rem;
    transform: rotate(-3.5deg);
    background: var(--violet);
    color: #fff;
    box-shadow: 0 0.5rem 1.75rem rgba(0, 0, 0, 0.45);
    z-index: 2;
  }
  .band--b {
    top: 0.35rem;
    transform: rotate(3.2deg);
    background: rgba(8, 8, 12, 0.9);
    border-block: 1px solid var(--line);
    color: var(--ink);
    z-index: 1;
  }
  .band__track {
    display: flex;
    width: max-content;
    will-change: transform;
    transform: translateZ(0);
    animation: marquee calc(var(--beat) * 32) linear infinite;
  }
  .band__track--rev { 
    animation-direction: reverse; 
    animation-duration: calc(var(--beat) * 48); 
    will-change: transform;
    transform: translateZ(0);
  }
  .band__item {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding-right: 0.85rem;
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 800;
    font-stretch: 120%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .band--b .band__item { font-weight: 600; opacity: 0.85; }
  .glyph {
    width: 0.85em;
    aspect-ratio: 3399 / 3133;
    background: currentColor;
    -webkit-mask: var(--iso) center / contain no-repeat;
    mask: var(--iso) center / contain no-repeat;
  }

  /* — Tablet y escritorio: título a la izquierda, iso a la derecha — */
  @media (min-width: 600px) {
    .stage {
      width: min(56vw, min(44vh, 380px));
    }
  }
  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
      grid-template-areas: 'copy stage';
      column-gap: clamp(2.5rem, 4.5vw, 4.5rem);
      align-items: center;
      gap: 0;
    }
    .stage {
      width: 100%;
      max-width: min(470px, 48vh);
      margin-left: auto;
      margin-right: 1.5rem;
    }
    .bands {
      height: 6.25rem;
    }
    .band {
      padding-block: 0.65rem;
    }
    .band--a {
      top: 1.6rem;
      transform: rotate(-2.4deg);
    }
    .band--b {
      top: 1.1rem;
      transform: rotate(1.8deg);
    }
    .band__item {
      font-size: 0.9rem;
      gap: 1.1rem;
      padding-right: 1.1rem;
      letter-spacing: 0.14em;
    }
  }

  /* — Animaciones a tempo — */
  @keyframes beat {
    0% { transform: scale(1.06); opacity: 1; }
    100% { transform: scale(1); opacity: 0.72; }
  }
  @keyframes ring {
    0% { transform: scale(0.45); opacity: 0; }
    15% { opacity: 1; }
    100% { transform: scale(1.35); opacity: 0; }
  }
  @keyframes ripple {
    0%, 100% { transform: scaleY(-1) skewX(0deg); }
    50% { transform: scaleY(-1.03) skewX(-1.5deg); }
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
  @keyframes rise {
    from { clip-path: inset(100% 0 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes up {
    from { opacity: 0; transform: translateY(0.75rem); }
    to { opacity: 1; transform: none; }
  }

  /* Con "reducir movimiento" */
  @media (prefers-reduced-motion: reduce) {
    .stage__glow,
    .stage__rings span,
    .stage__iso,
    .copy {
      animation: none !important;
    }
    .stage__rings span { opacity: 0.5; }
    .band__track { animation-duration: calc(var(--beat) * 96); }
    .band__track--rev { animation-duration: calc(var(--beat) * 128); }
    .stage__reflect .iso { animation-duration: calc(var(--beat) * 12); }
  }
</style>
