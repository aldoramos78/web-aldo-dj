---
---
<section id="hero" class="relative min-h-[100dvh] w-full flex flex-col justify-center items-center overflow-hidden pt-20 pb-12">
  
  <!-- Logo Iso de Fondo (Parallax vertical suave) -->
  <div id="hero-iso-container" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-0 opacity-25 lg:opacity-20 transition-transform duration-75 will-change-transform">
    <div class="w-[300px] sm:w-[520px] lg:w-[800px] xl:w-[950px] aspect-square flex items-center justify-center">
      <img 
        src="/imagenes/Iso.DJ.png" 
        alt="Aldo Deejay Isotipo" 
        class="w-full h-full object-contain filter drop-shadow-[0_0_50px_rgba(139,92,246,0.3)]"
        width="950"
        height="950"
        loading="eager"
      />
    </div>
  </div>

  <!-- Contenido y Jerarquía SEO H1: Centrado en viewport completo (100dvh) -->
  <div class="relative z-20 w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-10 xl:px-14 text-center my-auto py-6 sm:py-10">
    
    <!-- Badge de Localización -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-black/60 border border-white/15 backdrop-blur-md mb-6 sm:mb-8 text-xs sm:text-sm uppercase tracking-[0.28em] text-gray-300 font-bold">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
      Fuerteventura &bull; Lanzarote &bull; Canarias
    </div>

    <!-- H1 Semántico Brutalista de Alto Impacto -->
    <h1 class="font-black uppercase text-white tracking-tighter leading-[0.85] select-none text-[13vw] sm:text-[11vw] lg:text-[10rem] xl:text-[11.5rem] drop-shadow-[0_15px_35px_rgba(0,0,0,0.9)]">
      ALDO DEEJAY
    </h1>

    <!-- Subtítulo de Servicios (Potente, legible y contundente) -->
    <h2 class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-black uppercase tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white via-purple-100 to-white/80 mt-4 sm:mt-6 max-w-5xl mx-auto leading-tight">
      Música & Sesiones DJ para Hoteles, Bodas y Eventos
    </h2>

    <!-- Bajada descriptiva brutalista -->
    <p class="max-w-3xl mx-auto mt-6 sm:mt-8 text-base sm:text-xl lg:text-2xl text-gray-300 font-light leading-relaxed">
      Elegancia, estética y atmósfera: desde el groove envolvente de un atardecer junto al mar hasta el pulso dinámico de la pista de baile.
    </p>

    <!-- CTAs de Conversión Brutalistas -->
    <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
      <a href="#sets" class="btn-primary w-full sm:w-auto text-sm sm:text-base font-bold tracking-wider px-9 py-4 shadow-[0_0_30px_rgba(139,92,246,0.6)]">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Escuchar Sets
      </a>
      <a href="#contact" class="btn-secondary w-full sm:w-auto text-sm sm:text-base font-bold tracking-wider px-9 py-4 border-2 border-white/20 hover:border-white text-white">
        Consultar Disponibilidad
      </a>
    </div>

  </div>
</section>

<script>
  // Parallax Vertical Puro para el Isotipo (sin rotación 3D para máxima fluidez)
  const isoBg = document.getElementById('hero-iso-container');
  if (isoBg) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          isoBg.style.transform = `translate(-50%, calc(-50% + ${scrollY * 0.35}px))`;
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>
