---
const formats = [
  {
    title: "Aldo Deejay",
    format: "club",
    desc: "La mejor selección de rompepistas internacionales y los temazos de siempre. Energía y ritmo para mantener la pista llena.",
    image: "/imagenes/Dj.Hits.webp"
  },
  {
    title: "Dance Fever",
    format: "club",
    desc: "Voz en vivo y energía con los temas Disco-Dance imprescindibles. Ritmo, interacción y buen ambiente para una noche divertida.",
    image: "/imagenes/Dance.Fever.webp"
  },
  {
    title: "Poolside Sessions",
    format: "hotel",
    desc: "Sonidos lounge, organic house y beats relajados. La música idónea para terrazas, piscina y atardeceres frente al mar.",
    image: "/imagenes/Dj.Chill.webp"
  },
  {
    title: "Flamenco Grooves",
    format: "private",
    desc: "Ritmos ElectroFlamencos entrelazados con el arte, la elegancia y el zapateado de una bailarina flamenca.",
    image: "/imagenes/Flamenco.Grooves.webp"
  },
  {
    title: "Deep Blue Sea",
    format: "club",
    desc: "Acordes de violín eléctrico flotando sobre bases Deep & House. Un toque elegante para terrazas y eventos al atardecer.",
    image: "/imagenes/Deep.Blue.Sea.webp"
  },
  {
    title: "Octopus Party",
    format: "club",
    desc: "Una llamativa cabina hinchable de 8×3m, performance en directo y animación temática para un show visual diferente.",
    image: "/imagenes/Dj.Octopus.webp"
  }
];
---

<section id="showcase" class="scroll-mt-24 sm:scroll-mt-28 lg:scroll-mt-32 py-5 sm:py-7 lg:py-8 relative overflow-hidden">
  <!-- Contenedor Cinematográfico Extendido (w-full max-w-[1600px] como el resto) -->
  <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-10 xl:px-14">
    
    <!-- Encabezado con margen inferior generoso para que no se pegue a las tarjetas en móvil ni PC -->
    <div class="text-center mb-10 sm:mb-14 lg:mb-16">
      <span class="text-xs sm:text-sm font-bold tracking-[0.3em] text-[#A78BFA] uppercase block mb-3">
        Espectáculos Especiales
      </span>
      <h2 class="section-title !mb-4">
        SHOWCASE
      </h2>
      <div class="mx-auto w-36 h-[3px] rounded-full bg-gradient-to-r from-transparent via-[#8B5CF6] to-transparent shadow-[0_0_16px_rgba(139,92,246,0.9)] mb-4"></div>
      <p class="text-white max-w-2xl mx-auto text-base sm:text-lg font-normal leading-relaxed">
        Formatos y espectáculos especiales con puesta en escena propia.
      </p>
    </div>

    <!-- Coverflow Component Container -->
    <div class="relative w-full flex flex-col items-center">
      
      <!-- 3D Viewport con altura holgada para que no se monte nada -->
      <div class="coverflow-wrapper relative w-full h-[400px] sm:h-[480px] lg:h-[530px] flex items-center justify-center [perspective:1200px] select-none touch-pan-y">
        
        <!-- Flecha Anterior (Solo Escritorio) -->
        <button 
          id="coverflow-prev" 
          class="hidden lg:flex absolute left-6 xl:left-12 z-40 w-12 h-12 rounded-full bg-black/70 border border-purple-500/40 text-white items-center justify-center hover:bg-purple-600 hover:border-purple-400 transition-all shadow-[0_0_20px_rgba(139,92,246,0.4)] backdrop-blur-md"
          aria-label="Anterior Formato"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>

        <!-- Dynamic Items Container -->
        <div id="coverflow-stage" class="relative w-full h-full flex items-center justify-center [transform-style:preserve-3d]">
          {formats.map((item, index) => (
            <div 
              class={`coverflow-item absolute cursor-pointer rounded-2xl overflow-hidden shadow-2xl transition-all duration-500 ease-out will-change-transform ${index === 0 ? 'active' : ''}`}
              data-index={index}
              data-title={item.title}
              data-format={item.format}
              data-desc={item.desc}
            >
              <img 
                src={item.image} 
                alt={item.title} 
                class="w-full h-auto object-cover pointer-events-none rounded-2xl border border-white/10"
                width="360"
                height="450"
                loading="lazy"
              />
            </div>
          ))}
        </div>

        <!-- Flecha Siguiente (Solo Escritorio) -->
        <button 
          id="coverflow-next" 
          class="hidden lg:flex absolute right-6 xl:right-12 z-40 w-12 h-12 rounded-full bg-black/70 border border-purple-500/40 text-white items-center justify-center hover:bg-purple-600 hover:border-purple-400 transition-all shadow-[0_0_20px_rgba(139,92,246,0.4)] backdrop-blur-md"
          aria-label="Siguiente Formato"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>

      <!-- Tarjeta de Información y Acción Separada Holgadamente de los Carteles -->
      <div class="mt-10 sm:mt-14 lg:mt-16 w-full max-w-xl text-center glass-panel rounded-2xl p-6 sm:p-7 border border-purple-500/20 shadow-xl relative z-30">
        <h3 id="showcase-title" class="text-2xl sm:text-3xl font-extrabold text-white tracking-wide uppercase">
          {formats[0].title}
        </h3>
        <p id="showcase-desc" class="text-base sm:text-lg text-white font-normal mt-2 min-h-[48px] leading-relaxed">
          {formats[0].desc}
        </p>
        <div class="mt-4 flex items-center justify-center gap-3">
          <a 
            id="showcase-cta"
            href="#contact" 
            class="btn-primary text-xs sm:text-sm !py-2.5 !px-6"
          >
            RESERVAR ESTE FORMATO
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .coverflow-item {
    width: 250px;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.5s ease;
    will-change: transform, opacity;
  }
  @media (min-width: 640px) {
    .coverflow-item {
      width: 310px;
    }
  }
  @media (min-width: 1200px) {
    .coverflow-item {
      width: 350px;
    }
  }

  /* 3D transforms - Mobile first: compacto y centrado */
  .coverflow-item.active {
    transform: translateZ(90px) scale(1.05);
    opacity: 1;
    z-index: 50;
    box-shadow: 0 20px 45px rgba(0,0,0,0.85), 0 0 35px rgba(139,92,246,0.5);
    border: 2px solid #8B5CF6;
  }
  .coverflow-item.prev-1 {
    transform: translateX(-52%) translateZ(-80px) rotateY(28deg);
    opacity: 0.6;
    z-index: 30;
  }
  .coverflow-item.next-1 {
    transform: translateX(52%) translateZ(-80px) rotateY(-28deg);
    opacity: 0.6;
    z-index: 30;
  }
  .coverflow-item.prev-2 {
    transform: translateX(-95%) translateZ(-190px) rotateY(40deg);
    opacity: 0.25;
    z-index: 20;
  }
  .coverflow-item.next-2 {
    transform: translateX(95%) translateZ(-190px) rotateY(-40deg);
    opacity: 0.25;
    z-index: 20;
  }

  /* Desktop 1024px+: Tarjetas más abiertas manteniendo el efecto curvo */
  @media (min-width: 1024px) {
    .coverflow-item.prev-1 {
      transform: translateX(-82%) translateZ(-75px) rotateY(32deg);
      opacity: 0.75;
    }
    .coverflow-item.next-1 {
      transform: translateX(82%) translateZ(-75px) rotateY(-32deg);
      opacity: 0.75;
    }
    .coverflow-item.prev-2 {
      transform: translateX(-155%) translateZ(-180px) rotateY(44deg);
      opacity: 0.4;
    }
    .coverflow-item.next-2 {
      transform: translateX(155%) translateZ(-180px) rotateY(-44deg);
      opacity: 0.4;
    }
  }

  /* Large Desktop 1400px+: Máxima apertura cinematográfica curva */
  @media (min-width: 1400px) {
    .coverflow-item.prev-1 {
      transform: translateX(-96%) translateZ(-65px) rotateY(32deg);
      opacity: 0.8;
    }
    .coverflow-item.next-1 {
      transform: translateX(96%) translateZ(-65px) rotateY(-32deg);
      opacity: 0.8;
    }
    .coverflow-item.prev-2 {
      transform: translateX(-182%) translateZ(-170px) rotateY(45deg);
      opacity: 0.45;
    }
    .coverflow-item.next-2 {
      transform: translateX(182%) translateZ(-170px) rotateY(-45deg);
      opacity: 0.45;
    }
  }

  .coverflow-item.hidden-item {
    transform: translateZ(-350px);
    opacity: 0;
    z-index: 10;
    pointer-events: none;
  }
</style>

<script>
  let currentIndex = 0;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.coverflow-item'));
  const prevBtn = document.getElementById('coverflow-prev');
  const nextBtn = document.getElementById('coverflow-next');
  const titleEl = document.getElementById('showcase-title');
  const descEl = document.getElementById('showcase-desc');
  const stage = document.getElementById('coverflow-stage');

  function updateCoverflow() {
    const total = items.length;
    if (total === 0) return;

    items.forEach((item, index) => {
      item.classList.remove('active', 'prev-1', 'next-1', 'prev-2', 'next-2', 'hidden-item');

      let offset = (index - currentIndex + total) % total;
      if (offset > total / 2) offset -= total;

      if (offset === 0) {
        item.classList.add('active');
        if (titleEl) titleEl.textContent = item.dataset.title || '';
        if (descEl) descEl.textContent = item.dataset.desc || '';
      } else if (offset === -1) {
        item.classList.add('prev-1');
      } else if (offset === 1) {
        item.classList.add('next-1');
      } else if (offset === -2) {
        item.classList.add('prev-2');
      } else if (offset === 2) {
        item.classList.add('next-2');
      } else {
        item.classList.add('hidden-item');
      }
    });
  }

  function goNext() {
    currentIndex = (currentIndex + 1) % items.length;
    updateCoverflow();
  }

  function goPrev() {
    currentIndex = (currentIndex - 1 + items.length) % items.length;
    updateCoverflow();
  }

  prevBtn?.addEventListener('click', goPrev);
  nextBtn?.addEventListener('click', goNext);

  items.forEach((item, index) => {
    item.addEventListener('click', () => {
      currentIndex = index;
      updateCoverflow();
    });
  });

  // Touch Swipe Gesture Support
  let touchStartX = 0;
  let touchEndX = 0;

  stage?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  stage?.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 40) {
      if (diff > 0) goNext();
      else goPrev();
    }
  }, { passive: true });

  // Initialize
  updateCoverflow();
</script>
