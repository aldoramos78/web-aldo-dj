---
---
<section id="music-release" class="py-5 sm:py-7 lg:py-8 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl p-8 sm:p-12 lg:p-14 overflow-hidden border border-purple-500/30 bg-[#1A1A22] shadow-[0_0_50px_rgba(139,92,246,0.2)]">
      
      <!-- Glow decorativo suave de fondo -->
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-purple-600/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
        
        <!-- Portada limpia con texto debajo -->
        <div class="lg:col-span-5 flex flex-col items-center">
          <div class="w-64 sm:w-72 aspect-square rounded-2xl overflow-hidden border border-purple-500/40 shadow-2xl bg-black">
            <img 
              src="/imagenes/Portada_Creep.webp" 
              alt="Creep Cover - Aldo feat. Yami González" 
              class="w-full h-full object-cover"
              width="750"
              height="750"
              loading="lazy"
            />
          </div>
          <!-- Texto debajo de la portada -->
          <p class="mt-3 text-xs uppercase tracking-widest text-purple-300 font-semibold text-center">
            Primer single oficial
          </p>
        </div>

        <!-- Copy & CTAs -->
        <div class="lg:col-span-7 text-center lg:text-left space-y-4">
          <!-- Badge: Solo Lanzamiento inminente -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-900/50 text-purple-300 text-xs font-bold tracking-[0.25em] uppercase border border-purple-500/30">
            <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
            Lanzamiento Inminente
          </div>

          <!-- Título Brutalista -->
          <h3 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white uppercase tracking-tighter leading-tight">
            NUEVA ETAPA COMO PRODUCTOR
          </h3>

          <!-- Copy exacto solicitado -->
          <p class="text-gray-300 text-base sm:text-lg font-light leading-relaxed">
            Cover en clave Afro House del clásico "Creep". Interpretado por Yami González, artista Cubana con una voz cálida y elegante. Groove percusivo envolvente, atmósferas melódicas y la potencia adecuada para sets de club y atardeceres frente al mar.
          </p>

          <!-- CTA: Solo Pre-Save, sin DJ pack -->
          <div class="pt-2 flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
            <a href="/creep" class="btn-primary w-full sm:w-auto text-xs !py-3 !px-6">
              Acceder al Pre-Save
            </a>
            <span class="text-xs text-gray-400">
              Disponible próximamente en Spotify, Apple Music & Beatport
            </span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
